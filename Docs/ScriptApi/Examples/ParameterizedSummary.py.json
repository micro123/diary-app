{
  "apiVersion": "V2",
  "id": "parameterized-summary-python",
  "name": "参数化工时汇总（Python）",
  "description": "演示加载期参数声明、默认值和规范化参数读取。",
  "engine": "python",
  "scope": "Application",
  "entryKind": "Query",
  "parameters": [
    {
      "name": "range",
      "label": "统计范围",
      "type": "Choice",
      "required": true,
      "defaultValue": "thisWeek",
      "choices": [
        { "value": "thisWeek", "label": "本周" },
        { "value": "thisMonth", "label": "本月" }
      ]
    },
    {
      "name": "minimumHours",
      "label": "最低工时",
      "type": "Number",
      "defaultValue": "0"
    },
    {
      "name": "includeZero",
      "label": "包含零工时事项",
      "type": "Boolean",
      "defaultValue": "false"
    }
  ]
}
