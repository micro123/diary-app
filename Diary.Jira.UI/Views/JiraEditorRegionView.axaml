<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Diary.Jira.UI.ViewModels"
             xmlns:jira="clr-namespace:Diary.Jira;assembly=Diary.Jira"
             x:Class="Diary.Jira.UI.Views.JiraEditorRegionView"
             x:DataType="viewModels:JiraEditorRegionViewModel"
             Padding="0 4 0 0">
    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="110,*,Auto" RowSpacing="6" ColumnSpacing="8">
        <TextBlock Text="Jira Issue" Classes="FieldLabel" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding Issues}" SelectedIndex="{Binding IssueIndex}" Text="{Binding IssueText}">
            <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type jira:JiraIssueDisplay}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding Key}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Summary}" />
                        <TextBlock Text="{Binding Project, StringFormat='({0})'}" />
                    </StackPanel>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="2" Content="刷新" Command="{Binding RefreshIssuesCommand}" IsEnabled="{Binding !Refreshing}" />
        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                   Text="保存后追加 Jira 工时，已提交的记录不可重复上传。"
                   Classes="SectionDescription" />
    </Grid>
</UserControl>
