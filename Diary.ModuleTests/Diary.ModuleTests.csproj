    <ProjectReference Include="..\Diary.ModuleBase\Diary.ModuleBase.csproj" />
    <ProjectReference Include="..\Diary.ModuleUI\Diary.ModuleUI.csproj" />
    <ProjectReference Include="..\Diary.Mcp.Remote\Diary.Mcp.Remote.csproj" />
    <ProjectReference Include="..\Diary.ModuleTestFixture\Diary.ModuleTestFixture.csproj" />
    <ProjectReference Include="..\Diary.ScriptHost\Diary.ScriptHost.csproj" />
  </ItemGroup>
</Project>
