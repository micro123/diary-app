<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:vm="clr-namespace:Diary.Agent.UI.ViewModels"
             x:Class="Diary.Agent.UI.Views.AiAgentPageView"
             x:DataType="vm:AiAgentPageViewModel"
             mc:Ignorable="d">
    <Grid RowDefinitions="Auto,*,Auto" Margin="8" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                <StackPanel Grid.RowSpan="2" VerticalAlignment="Center">
                    <TextBlock Text="AI 助手" Classes="PageTitle" />
                    <TextBlock Text="模型只能通过已启用工具读取 DiaryApp 数据；本地备注不会提供给模型。"
                               TextWrapping="Wrap" Opacity="0.72" />
                </StackPanel>
                <Grid Grid.Column="1" ColumnDefinitions="Auto,240,Auto" ColumnSpacing="8">
                    <TextBlock Text="模型连接" VerticalAlignment="Center" Opacity="0.72" />
                    <ComboBox Grid.Column="1" MinWidth="240" PlaceholderText="选择模型连接"
                              ItemsSource="{Binding Profiles}"
                              SelectedItem="{Binding SelectedProfile}"
                              DisplayMemberBinding="{Binding DisplayName}" />
                    <Button Grid.Column="2" Classes="Primary" MinWidth="88" Content="新建会话"
                            Command="{Binding NewSessionCommand}" />
                </Grid>
                <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,240,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="历史会话" VerticalAlignment="Center" Opacity="0.72" />
                    <ComboBox Grid.Column="1" MinWidth="240" PlaceholderText="选择历史会话"
                              ItemsSource="{Binding Conversations}"
                              SelectedItem="{Binding SelectedConversation}"
                              DisplayMemberBinding="{Binding DisplayText}" />
                    <Button Grid.Column="2" MinWidth="88" Content="恢复会话"
                            Command="{Binding LoadConversationCommand}" />
                    <Button Grid.Column="3" MinWidth="72" Content="删除"
                            Command="{Binding DeleteConversationCommand}" />
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="3*,2*" ColumnSpacing="8">
            <Border Classes="DetailPane" Padding="8">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                        <TextBlock Grid.Column="1" Text="{Binding ModeText}" Opacity="0.65" />
                        <TextBlock Grid.Column="2" Text="{Binding ContextUsageText}"
                                   Foreground="{Binding ContextUsageBrush}"
                                   IsVisible="{Binding IsContextUsageVisible}"
                                   ToolTip.Tip="{Binding ContextUsageToolTip}" />
                    </Grid>
                    <ScrollViewer x:Name="ChatScrollViewer" Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AiChatMessageViewModel">
                                    <Border Margin="0,0,0,10" Padding="12" Classes="DetailPane">
                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Classes="CompactActions"
                                                            IsVisible="{Binding HasUserActions}">
                                                    <Button Theme="{DynamicResource BorderlessButton}"
                                                            Padding="5,2"
                                                            Command="{Binding $parent[UserControl].DataContext.CopyMessageCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="复制这条用户消息">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <i:Icon Value="mdi-content-copy" FontSize="14" />
                                                            <TextBlock Text="复制" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Theme="{DynamicResource BorderlessButton}"
                                                            Padding="5,2"
                                                            Command="{Binding $parent[UserControl].DataContext.FillMessageInputCommand}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip.Tip="用这条消息替换当前输入">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <i:Icon Value="mdi-arrow-down-bold-box-outline" FontSize="14" />
                                                            <TextBlock Text="填入" FontSize="12" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                            <Expander Grid.Row="1" Header="思考过程"
                                                      IsVisible="{Binding HasReasoning}"
                                                      IsExpanded="False">
                                                <Border Margin="0,4,0,2" Padding="10"
                                                        Background="#0D6B7280"
                                                        CornerRadius="6">
                                                    <SelectableTextBlock Text="{Binding ReasoningDisplayText}"
                                                                         TextWrapping="Wrap"
                                                                         FontStyle="Italic"
                                                                         Opacity="0.78" />
                                                </Border>
                                            </Expander>
                                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Images}"
                                                          IsVisible="{Binding HasImages}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:AiImageAttachmentViewModel">
                                                        <Border Padding="4" CornerRadius="6"
                                                                BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                                BorderThickness="1">
                                                            <StackPanel Spacing="3">
                                                                <Image Source="{Binding Preview}" Width="160" Height="120"
                                                                       Stretch="Uniform" />
                                                                <TextBlock Text="{Binding FileName}" MaxWidth="160"
                                                                           TextTrimming="CharacterEllipsis" FontSize="11" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <SelectableTextBlock Grid.Row="3" Text="{Binding Content}"
                                                                 TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Grid.Column="1" Classes="DetailPane" Padding="8">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                    <TextBlock Text="工具调用" FontWeight="SemiBold" />
                    <Border Grid.Row="1" IsVisible="{Binding HasPendingConfirmation}"
                            Classes="DetailPane" Padding="10" BorderBrush="#D97706" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7" MaxHeight="440"
                              DataContext="{Binding PendingConfirmation}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="确认创建事项" FontWeight="SemiBold" />
                                <TextBlock Text="请检查实际写入字段。不会永久跳过确认。" TextWrapping="Wrap" Opacity="0.72" />
                            </StackPanel>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="7" Margin="0,0,4,0">
                                    <Grid ColumnDefinitions="80,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                                        <TextBlock Text="日期" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding Date}" />
                                        <TextBlock Grid.Row="1" Text="标题" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Title}" />
                                        <TextBlock Grid.Row="2" Text="工时" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding Hours}" Minimum="0.01" Maximum="24" />
                                        <TextBlock Grid.Row="3" Text="优先级" VerticalAlignment="Center" />
                                        <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Priority}" Minimum="0" Maximum="9" Increment="1" />
                                        <TextBlock Grid.Row="4" Text="标签 ID" VerticalAlignment="Center" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding TagIdsText}" />
                                    </Grid>
                                    <TextBlock Text="备注" />
                                    <TextBox Text="{Binding Note}" AcceptsReturn="True" MinHeight="54" TextWrapping="Wrap" />
                                    <TextBlock Text="附加字段 JSON" />
                                    <TextBox Text="{Binding ExtraFieldsJson}" AcceptsReturn="True" MinHeight="64"
                                             FontFamily="Consolas" TextWrapping="NoWrap" />
                                    <TextBlock Text="{Binding ValidationMessage}" Foreground="#DC2626" TextWrapping="Wrap" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                <Button Content="拒绝" Command="{Binding $parent[UserControl].DataContext.RejectWriteCommand}" />
                                <Button Grid.Column="1" Content="编辑后确认"
                                        Command="{Binding $parent[UserControl].DataContext.EditAndConfirmWriteCommand}" />
                                <Button Grid.Column="2" HorizontalAlignment="Right" Classes="Primary" Content="确认"
                                        Command="{Binding $parent[UserControl].DataContext.ConfirmWriteCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" IsVisible="{Binding HasPendingExternalConfirmation}"
                            Classes="DetailPane" Padding="10" BorderBrush="#D97706" BorderThickness="1">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="7" MaxHeight="440"
                              DataContext="{Binding PendingExternalConfirmation}">
                            <TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="7" Margin="0,0,4,0">
                                    <TextBlock Text="工具来源" Opacity="0.65" />
                                    <SelectableTextBlock Text="{Binding ServerName}" TextWrapping="Wrap" />
                                    <TextBlock Text="工具" Opacity="0.65" />
                                    <SelectableTextBlock Text="{Binding ToolName}" TextWrapping="Wrap" />
                                    <TextBlock Text="参数" Opacity="0.65" />
                                    <TextBox Text="{Binding ArgumentsJson}" IsReadOnly="True" AcceptsReturn="True"
                                             MinHeight="90" FontFamily="Consolas" TextWrapping="NoWrap" />
                                    <TextBlock Text="变更预览" Opacity="0.65" IsVisible="{Binding HasPreview}" />
                                    <TextBox Text="{Binding PreviewText}" IsReadOnly="True" AcceptsReturn="True"
                                             MinHeight="140" MaxHeight="280" FontFamily="Consolas"
                                             TextWrapping="Wrap" IsVisible="{Binding HasPreview}" />
                                    <TextBlock Text="工具声明不会自动授予写权限；本次调用必须由你确认。"
                                               TextWrapping="Wrap" Opacity="0.72" />
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Button Content="拒绝"
                                        Command="{Binding $parent[UserControl].DataContext.RejectExternalToolCommand}" />
                                <Button Grid.Column="1" HorizontalAlignment="Right" Classes="Primary" Content="确认调用"
                                        Command="{Binding $parent[UserControl].DataContext.ConfirmExternalToolCommand}" />
                            </Grid>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2">
                        <ItemsControl ItemsSource="{Binding ToolCalls}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AiToolCallViewModel">
                                    <Border Margin="0,0,0,8" Padding="10" Classes="DetailPane">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Status}" Opacity="0.72" />
                                            </Grid>
                                            <SelectableTextBlock Text="{Binding ArgumentsSummary}" TextWrapping="Wrap" Opacity="0.65" />
                                            <SelectableTextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                                <SelectableTextBlock Text="{Binding Source}" TextWrapping="Wrap" Opacity="0.6" />
                                                <Button Grid.Column="1" Content="{Binding OutputButtonText}"
                                                        IsVisible="{Binding HasOutput}"
                                                        Command="{Binding ToggleOutputCommand}" />
                                                <TextBlock Grid.Column="2" Text="{Binding DurationText}" Opacity="0.6"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <Border IsVisible="{Binding IsOutputVisible}"
                                                    BorderBrush="{DynamicResource ThemeBorderLowBrush}"
                                                    BorderThickness="1" CornerRadius="5" Padding="6">
                                                <TextBox Text="{Binding Output}" IsReadOnly="True" AcceptsReturn="True"
                                                         MinHeight="90" MaxHeight="280" FontFamily="Consolas"
                                                         TextWrapping="NoWrap"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" RowDefinitions="Auto,Auto,Auto"
              ColumnSpacing="8" RowSpacing="4">
            <ItemsControl Grid.ColumnSpan="3" ItemsSource="{Binding PendingImages}"
                          IsVisible="{Binding HasPendingImages}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AiImageAttachmentViewModel">
                        <Border Padding="5" CornerRadius="6"
                                BorderBrush="{DynamicResource ThemeBorderLowBrush}" BorderThickness="1">
                            <Grid ColumnDefinitions="64,Auto" ColumnSpacing="5">
                                <Image Source="{Binding Preview}" Width="64" Height="48" Stretch="UniformToFill" />
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding FileName}" MaxWidth="150" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Details}" FontSize="10" Opacity="0.6" />
                                    <Button Theme="{DynamicResource BorderlessButton}" Padding="2"
                                            HorizontalAlignment="Left"
                                            Command="{Binding $parent[UserControl].DataContext.RemovePendingImageCommand}"
                                            CommandParameter="{Binding}" ToolTip.Tip="移除图片">
                                        <i:Icon Value="mdi-close" FontSize="14" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBox x:Name="AiAgentInputTextBox" Grid.Row="1" Text="{Binding Input}"
                     Watermark="输入问题或工作记录需求…"
                     AcceptsReturn="True" MinHeight="72" MaxHeight="180"
                     Padding="10,8"
                     TextWrapping="Wrap" TextAlignment="Left"
                     VerticalContentAlignment="Top"
                     ToolTip.Tip="Enter 或 Ctrl+Enter 发送；Shift+Enter 换行；↑/↓ 浏览当前运行期提示词历史" />
            <Button Grid.Row="1" Grid.Column="1" Width="36" Height="36" Padding="0"
                    VerticalAlignment="Center" Command="{Binding AddImagesCommand}"
                    IsEnabled="{Binding CanAttachImages}" ToolTip.Tip="{Binding ImageInputHint}"
                    AutomationProperties.Name="添加图片">
                <i:Icon Value="mdi-image-plus" FontSize="18" />
            </Button>
            <Grid Grid.Row="1" Grid.Column="2" VerticalAlignment="Center">
                <Button Width="40" Height="40" Padding="0" CornerRadius="20"
                        Classes="Danger" Command="{Binding StopCommand}"
                        IsVisible="{Binding IsBusy}"
                        ToolTip.Tip="停止生成"
                        AutomationProperties.Name="停止生成">
                    <i:Icon Value="mdi-stop" FontSize="18" />
                </Button>
                <Button Width="40" Height="40" Padding="0" CornerRadius="20"
                        Classes="Primary" Command="{Binding SendCommand}"
                        IsVisible="{Binding !IsBusy}"
                        ToolTip.Tip="发送消息"
                        AutomationProperties.Name="发送消息">
                    <i:Icon Value="mdi-send" FontSize="18" />
                </Button>
            </Grid>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="3"
                       Text="Enter / Ctrl+Enter 发送 · Shift+Enter 换行 · Ctrl+V 粘贴图片或文字 · ↑/↓ 历史"
                       FontSize="11" Opacity="0.62" />
        </Grid>
    </Grid>
</UserControl>
