<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u-semi="https://irihi.tech/ursa/themes/semi"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:u="clr-namespace:Ursa.Controls;assembly=Ursa"
             x:Class="Diary.App.App"
             x:DataType="local:AppModel"
             xmlns:local="using:Diary.App"
             xmlns:guiBase="clr-namespace:Diary.GUIBase;assembly=Diary.GUIBase"
             xmlns:giBaseVm="clr-namespace:Diary.GUIBase.ViewModels;assembly=Diary.GUIBase"
             xmlns:appVm="clr-namespace:Diary.App.ViewModels"
             Name="Diary Tools NG">
    
    <Design.DataContext>
        <local:AppModel />
    </Design.DataContext>

    <Application.DataTemplates>
        <guiBase:ViewLocator />
        <!-- SettingDataTemplates: SettingsView 和 GenericConfigView 及其他设置对话框共享 -->
        <DataTemplate DataType="{x:Type giBaseVm:SettingGroup}">
            <Expander Classes="Settings" IsExpanded="False">
                <Expander.Header>
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Classes="SectionHeader" Text="{Binding Title}"
                                   FontSize="{StaticResource SemiFontSizeHeader3}"
                                   HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        <Border Grid.Column="2"
                                IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                                Classes="HelperIcon"/>
                    </Grid>
                </Expander.Header>
                <ItemsControl Classes="Settings" ItemsSource="{Binding Children}" />
            </Expander>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingText}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <TextBox Classes="SLV ClearButton" Classes.RevealPasswordButton="{Binding Password}"
                         Grid.Column="1" Text="{Binding Value}"
                         PasswordChar="{Binding MaskChar}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type appVm:SettingFont}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" VerticalAlignment="Top" Margin="0,7,0,0" />
                <StackPanel Grid.Column="1" Spacing="8">
                    <ComboBox Classes="SLV" ItemsSource="{Binding SourceOptions}"
                              SelectedItem="{Binding Source, Mode=TwoWay}" />
                    <ComboBox Classes="SLV" ItemsSource="{Binding SystemFontFamilies}"
                              SelectedItem="{Binding SystemFontFamily, Mode=TwoWay}"
                              IsVisible="{Binding IsSystemFont}" />
                    <u:PathPicker Classes="SLV" AllowMultiple="False"
                                  UsePickerType="{Binding PickerType}"
                                  SelectedPathsText="{Binding FontFilePath, Mode=TwoWay}"
                                  Title="选择字体文件" IsClearSelectionOnCancel="False"
                                  SuggestedStartPath="{Binding FontFileDirectory}"
                                  ToolTip.Tip="{Binding FontFilePath}"
                                  IsVisible="{Binding IsFontFile}" />
                    <TextBlock Text="{Binding FontFileStatus}" TextWrapping="Wrap" Opacity="0.72"
                               IsVisible="{Binding IsFontFile}" />
                    <TextBlock Text="默认字体为 Noto Sans Mono CJK SC；保存后立即生效，字体不可用时安全回退。" Opacity="0.62" />
                </StackPanel>
                <Border Grid.Column="2" VerticalAlignment="Top" Margin="0,7,0,0"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingPath}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <u:PathPicker Grid.Column="1" Classes="SLV" AllowMultiple="False"
                              UsePickerType="{Binding PickerType}" SelectedPathsText="{Binding Value}"
                              Title="{Binding PickerTitle}" IsClearSelectionOnCancel="False"
                              SuggestedStartPath="{Binding DirName}" ToolTip.Tip="{Binding Value}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingInteger}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <u:NumericLongUpDown Grid.Column="1" Classes="SLV" Value="{Binding Value}"
                                     Minimum="{Binding MinValue}"
                                     Maximum="{Binding MaxValue}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingReal}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <u:NumericDoubleUpDown Grid.Column="1" Classes="SLV" Value="{Binding Value}"
                                       Minimum="{Binding MinValue}"
                                       Maximum="{Binding MaxValue}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingSwitch}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
            <ToggleSwitch Grid.Column="1" Classes="SLV" IsChecked="{Binding Value, Mode=TwoWay}"
                              VerticalAlignment="Center" OnContent="" OffContent=""
                              HorizontalContentAlignment="Left" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingChoice}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <ComboBox Grid.Column="1" Classes="SLV Bordered" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                          ItemsSource="{Binding Options}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type giBaseVm:SettingButton}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <Button Grid.Column="1" Classes="SLV" Content="{Binding Text}"
                        Command="{Binding ExecuteCommand}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type appVm:McpStatusSetting}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <TextBlock Grid.Column="1" Width="400" FontSize="18"
                           Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
        <DataTemplate DataType="{x:Type appVm:McpActionSetting}">
            <Grid Classes="SettingLineBox" ColumnDefinitions="Auto,Auto,Auto,*" VerticalAlignment="Center">
                <TextBlock Classes="SettingLineCaption" />
                <Button Grid.Column="1" Classes="SLV" Classes.Primary="{Binding Primary}"
                        Content="{Binding Text}" Command="{Binding Command}"
                        IsEnabled="{Binding IsEnabled}" />
                <Border Grid.Column="2"
                        IsVisible="{Binding HasHelp}" ToolTip.Tip="{Binding HelpTip}"
                        Classes="HelperIcon"/>
            </Grid>
        </DataTemplate>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Diary.GUIBase/Resources/AppResources.axaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <semi:SemiTheme Locale="zh-CN" />
        <u-semi:SemiTheme Locale="zh-CN" />
        <StyleInclude Source="avares://Diary.GUIBase/Resources/AppStyles.axaml"/>
        <StyleInclude Source="avares://Semi.Avalonia.ColorPicker/Index.axaml" />
        <StyleInclude Source="avares://Semi.Avalonia.DataGrid/Index.axaml" />
        <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Generic.axaml"/>
        <semi:AvaloniaEditSemiTheme />
        <Style Selector="TemplatedControl">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>
    </Application.Styles>

    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="/Assets/Icons/diary-app.ico" ToolTipText="{x:Static local:AppInfo.AppName}"
                      Command="{Binding RaiseWindowCommand}" IsVisible="{Binding TrayVisible}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="{x:Static local:AppInfo.AppVersionString}" IsEnabled="False"/>
                        <NativeMenuItem Header="关于" Command="{Binding ShowAboutCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="退出" Command="{Binding QuitAppCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>
