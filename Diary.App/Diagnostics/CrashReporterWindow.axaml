<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diary.App.Diagnostics.CrashReporterWindow"
        Title="Diary Tools NG 崩溃报告"
        Width="720" Height="540"
        MinWidth="600" MinHeight="440"
        CanResize="True"
        ShowInTaskbar="True"
        SystemDecorations="None"
        WindowStartupLocation="CenterScreen">
    <Grid RowDefinitions="Auto,*">
        <Border Padding="12,8"
                Background="{DynamicResource SemiColorFill2}"
                BorderBrush="{DynamicResource SemiColorBorder}"
                BorderThickness="0,0,0,1"
                PointerPressed="OnBeginMoveDrag">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                <Image Source="/Assets/Icons/diary-app.ico" Width="22" Height="22" />
                <TextBlock Grid.Column="1"
                           Text="Diary Tools NG 崩溃报告"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button Grid.Column="2"
                        Content="关闭"
                        Theme="{DynamicResource BorderlessButton}"
                        Click="OnClose" />
            </Grid>
        </Border>

        <Grid x:Name="RootGrid"
              Grid.Row="1"
              RowDefinitions="Auto,*,Auto"
              RowSpacing="10"
              Margin="14">
            <Border Classes="PageHeader">
                <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                    <TextBlock Text="Diary Tools NG 意外退出" Classes="PageTitle" />
                    <TextBlock Grid.Column="1"
                               Text="诊断信息已尽可能保存"
                               Classes="PageSubtitle" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="DetailPane" Padding="12" ClipToBounds="True">
                <ScrollViewer x:Name="DetailsScrollViewer"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="10">
                        <Border Classes="SectionCard">
                            <StackPanel Spacing="6">
                                <Grid Classes="SectionHeading" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="错误摘要" Classes="SectionTitle" />
                                    <TextBlock Grid.Column="1"
                                               Text="异常类型与发生时间"
                                               Classes="SectionDescription" />
                                </Grid>
                                <SelectableTextBlock x:Name="ExceptionTypeText"
                                                     FontWeight="SemiBold"
                                                     TextWrapping="Wrap" />
                                <SelectableTextBlock x:Name="ExceptionMessageText"
                                                     TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Classes="SectionCard">
                            <StackPanel Spacing="8">
                                <Grid Classes="SectionHeading" ColumnDefinitions="Auto,*">
                                    <TextBlock Text="诊断文件" Classes="SectionTitle" />
                                    <TextBlock Grid.Column="1"
                                               Text="用于定位本次异常"
                                               Classes="SectionDescription" />
                                </Grid>
                                <Border Classes="SubtleCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="DumpStatusText"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <SelectableTextBlock x:Name="DumpPathText"
                                                             Classes="PageSubtitle"
                                                             TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Classes="SubtleCard">
                                    <StackPanel Spacing="4">
                                        <TextBlock x:Name="LogStatusText"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <SelectableTextBlock x:Name="LogPathText"
                                                             Classes="PageSubtitle"
                                                             TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Classes="SubtleCard">
                            <TextBlock Text="Dump 和日志可能包含路径、账户名等敏感信息，请确认内容后再提供给他人。"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <StackPanel x:Name="ActionsPanel" Grid.Row="2" Classes="DialogFooter">
                <Button x:Name="OpenDumpFolderButton"
                        Content="打开 Dump 文件夹"
                        Click="OnOpenDumpFolder" />
                <Button Classes="Primary" Content="关闭" Click="OnClose" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
