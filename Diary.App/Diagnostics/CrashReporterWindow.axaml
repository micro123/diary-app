<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Diary.App.Diagnostics.CrashReporterWindow"
        Title="Diary Tools NG 崩溃报告"
        Width="640" Height="420"
        MinWidth="520" MinHeight="360"
        CanResize="True"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen">
    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" RowSpacing="14" Margin="24">
        <StackPanel Spacing="4">
            <TextBlock Text="Diary Tools NG 意外退出" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="程序已尝试保存诊断 Dump 和滚动日志，可将其用于定位崩溃原因。"
                       Opacity="0.72" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer x:Name="DetailsScrollViewer" Grid.Row="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="14">
                <Border Padding="14" CornerRadius="8" Background="#18000000">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="ExceptionTypeText" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <SelectableTextBlock x:Name="ExceptionMessageText" Opacity="0.8" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <StackPanel Spacing="5">
                    <TextBlock x:Name="DumpStatusText" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="DumpPathText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock x:Name="LogStatusText" Margin="0,6,0,0"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <SelectableTextBlock x:Name="LogPathText" Opacity="0.7" TextWrapping="Wrap" />
                    <TextBlock Text="Dump 和日志可能包含敏感信息，请在确认后再提供给他人。"
                               Foreground="#D97706" TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <StackPanel x:Name="ActionsPanel" Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Spacing="10">
            <Button x:Name="OpenDumpFolderButton" Content="打开 Dump 文件夹" Click="OnOpenDumpFolder" />
            <Button Content="关闭" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
