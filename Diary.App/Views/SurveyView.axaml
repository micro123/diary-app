<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:u="https://irihi.tech/ursa"
             x:DataType="viewModels:SurveyViewModel"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:app="clr-namespace:Diary.App"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             xmlns:views="clr-namespace:Diary.App.Views"
             xmlns:models="clr-namespace:Diary.App.Models"
             x:Class="Diary.App.Views.SurveyView">
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <TextBlock Text="没有启用调查功能，此页面不可用" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="48"
                   IsVisible="{Binding !SurveyEnabled, Source={x:Static app:App.Instance}}"
                   Foreground="{DynamicResource ButtonDefaultDisabledForeground}" />
        <DockPanel IsVisible="{Binding SurveyEnabled, Source={x:Static app:App.Instance}}"
                   VerticalSpacing="8">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4">
                <TextBlock Text="时间范围：" />
                <CalendarDatePicker SelectedDate="{Binding StartDate}" IsTodayHighlighted="True"/>
                <TextBlock Text="至" />
                <CalendarDatePicker SelectedDate="{Binding EndDate}" IsTodayHighlighted="True"/>
                <views:QuickDateSelectButton />
                <Button Command="{Binding SendQueryCommand}"
                        Theme="{DynamicResource BorderlessButton}" Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <i:Icon Value="mdi-account-voice" />
                        <TextBlock Text="发起调查" />
                    </StackPanel>
                </Button>
                <TextBlock Text="正在调查中..." IsVisible="{Binding Surveying}"
                           Foreground="{DynamicResource ButtonDefaultSuccessForeground}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="4" DockPanel.Dock="Top">
                <TextBlock Text="自定义总时间" />
                <u:NumericDoubleUpDown ShowButtonSpinner="True" InnerRightContent="小时" Width="120"
                                       Value="{Binding CustomTotal}" />
                <Button Command="{Binding ReCalcCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <i:Icon Value="mdi-check-circle-outline" />
                        <TextBlock Text="重新计算" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Top">
                <Button Command="{Binding DiscoverCapabilitiesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <i:Icon Value="mdi-lan-connect" />
                        <TextBlock Text="探测新版节点" />
                    </StackPanel>
                </Button>
                <TextBlock Text="{Binding CapabilityStatus}" Opacity="0.7" />
            </StackPanel>
            <Expander Header="已发现的新版节点能力" DockPanel.Dock="Top">
                <ItemsControl ItemsSource="{Binding PeerCapabilities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SurveyCapabilityResult">
                            <Grid ColumnDefinitions="180,*,*,*" ColumnSpacing="8" Margin="0,2">
                                <TextBlock Text="{Binding NodeName}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="查询：{Binding KindsText}" />
                                <TextBlock Grid.Column="2" Text="分组：{Binding GroupDimensionsText}" />
                                <TextBlock Grid.Column="3" Text="{Binding DetailsText}" Opacity="0.7" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
            <Expander Header="扩展查询（仅新版节点）" DockPanel.Dock="Top">
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="关键词" />
                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding ExtendedText}"
                             Watermark="事项标题或备注，可留空" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="标签名" />
                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding ExtendedTagNames}"
                             Watermark="多个标签用逗号分隔" />
                    <TextBlock Grid.Row="0" Grid.Column="4" Text="标签模式" />
                    <ComboBox Grid.Row="0" Grid.Column="5" ItemsSource="{Binding ExtendedTagFilters}"
                              SelectedIndex="{Binding ExtendedTagFilterIndex}" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="优先级" />
                    <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ExtendedPriorities}"
                              SelectedIndex="{Binding ExtendedPriorityIndex}" />
                    <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="4"
                               Text="填写任一扩展条件后，将只发送到支持 v2 的调查节点。"
                               Opacity="0.7" />
                </Grid>
            </Expander>
            <TextBlock DockPanel.Dock="Top" Text="{Binding QueryMode}" Opacity="0.7" />
            <ItemsControl ItemsSource="{Binding SurveyResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:SurveyResult">
                        <Expander Header="{Binding Title}" IsExpanded="True">
                            <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,*">
                                <TextBlock Grid.Column="0" Grid.Row="0" Text="日期：" />
                                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Range}" />
                                <TextBlock Grid.Column="0" Grid.Row="1" Text="总耗时：" />
                                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Total}" />
                                <TreeDataGrid Grid.Column="0" Grid.Row="2" Grid.ColumnSpan="2"
                                              CanUserResizeColumns="False" CanUserSortColumns="False"
                                              Source="{Binding GridSource}" >
                                    <Interaction.Behaviors>
                                        <EventTriggerBehavior EventName="Tapped">
                                            <InvokeCommandAction PassEventArgsToCommand="True"
                                                                 Command="{Binding ToggleExpandCommand}"/>
                                        </EventTriggerBehavior>
                                    </Interaction.Behaviors>
                                    <TreeDataGrid.Styles>
                                        <Style Selector="TreeDataGridRow">
                                            <Style Selector="^ /template/ Border#RowBorder">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Focusable" Value="False" />
                                            </Style>
                                            <Style Selector="^:pointerover /template/ Border#RowBorder">
                                                <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
                                            </Style>
                                            <Style Selector="^:selected">
                                                <Style
                                                    Selector="^ /template/ TreeDataGridCellsPresenter#PART_CellsPresenter">
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="^ /template/ Border#RowBorder">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SemiColorPrimaryLight}" />
                                                </Style>
                                                <Style Selector="^:pointerover /template/ Border#RowBorder">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
                                                </Style>
                                                <Style Selector="^:focus /template/ Border#RowBorder">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SemiColorPrimaryLight}" />
                                                </Style>
                                                <Style Selector="^:pointerover:focus /template/ Border#RowBorder">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource SemiColorPrimaryLightPointerover}" />
                                                </Style>
                                            </Style>
                                        </Style>
                                    </TreeDataGrid.Styles>
                                    <TreeDataGrid.Resources>
                                        <DataTemplate DataType="models:RespondTag" x:Key="NameCell">
                                            <TextBlock Text="{Binding TagName}"
                                                       Classes.Warning="{Binding IsAnno}"
                                                       Classes.Danger="{Binding !IsValid}"
                                                       Classes="GridText"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="models:RespondTag" x:Key="TimeCell">
                                            <TextBlock Text="{Binding TagTime, StringFormat='{}{0:0.##} 小时'}"
                                                       IsVisible="{Binding IsValid}"
                                                       Classes.Warning="{Binding IsAnno}"
                                                       Classes="GridText"/>
                                        </DataTemplate>
                                        <DataTemplate DataType="models:RespondTag" x:Key="PercentCell">
                                            <TextBlock Text="{Binding Percent, StringFormat='{}{0:0.##} %'}"
                                                       IsVisible="{Binding IsValid}"
                                                       Classes.Warning="{Binding IsAnno}"
                                                       Classes="GridText"/>
                                        </DataTemplate>
                                    </TreeDataGrid.Resources>
                                </TreeDataGrid>
                            </Grid>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DockPanel>
    </Panel>
</UserControl>
