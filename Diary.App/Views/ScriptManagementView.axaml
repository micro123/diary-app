<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
              xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:vm="using:Diary.App.ViewModels"
               xmlns:models="using:Diary.App.Models"
               xmlns:views="using:Diary.App.Views"
              xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="Diary.App.Views.ScriptManagementView"
             x:DataType="vm:ScriptManagementViewModel"
             mc:Ignorable="d" d:DesignWidth="960" d:DesignHeight="640"
             Padding="16">
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
            <StackPanel>
                <TextBlock Text="脚本工作台" FontSize="30" FontWeight="Bold" />
                <TextBlock Text="管理本机脚本，支持应用自动化和编辑器操作。"
                           Opacity="0.68" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="新建脚本" Command="{Binding CreateScriptCommand}" Classes="Primary" />
                <Button Content="打开脚本目录" Command="{Binding OpenScriptsFolderCommand}" />
                <Button Content="重新加载" Command="{Binding ReloadCommand}"
                        IsEnabled="{Binding CanReload}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="12" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <TextBlock Text="{Binding Status}" />
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="搜索脚本名称或 ID" />
            <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding ScopeFilters}"
                      SelectedItem="{Binding SelectedScopeFilter, Mode=TwoWay}" />
            <ComboBox Grid.Column="2" Width="140" ItemsSource="{Binding StatusFilters}"
                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="3*,2*" ColumnSpacing="16">
            <Grid>
                <ListBox ItemsSource="{Binding VisibleScripts}" SelectedItem="{Binding SelectedScript}">
                    <ListBox.ItemContainerTheme>
                        <ControlTheme TargetType="ListBoxItem"
                                      BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ScriptListItem">
                            <Grid Margin="8" HorizontalAlignment="Stretch"
                                  Background="Transparent"
                                  ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="打开源码"
                                                  Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).OpenScriptCommand}"
                                                  CommandParameter="{Binding}" />
                                        <MenuItem Header="打开所在目录"
                                                  Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).OpenScriptDirectoryCommand}"
                                                  CommandParameter="{Binding}" />
                                        <Separator />
                                        <MenuItem Header="重新检查"
                                                  Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).RecheckScriptCommand}"
                                                  CommandParameter="{Binding}" />
                                          <MenuItem Header="运行脚本"
                                                    Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).RunScriptCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding IsRunnable}" />
                                         <MenuItem Header="删除脚本"
                                                   Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).DeleteScriptCommand}"
                                                   CommandParameter="{Binding}" />
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid Grid.Column="0" Width="28" Height="28"
                                      ToolTip.Tip="{Binding Language}">
                                    <Image Source="{SvgImage /Assets/Icons/csharp-72.svg}"
                                           Width="28" Height="28"
                                           IsVisible="{Binding IsCSharp}" />
                                    <Image Source="{SvgImage /Assets/Icons/python-logo-only.svg}"
                                           Width="28" Height="28"
                                           IsVisible="{Binding IsPython}" />
                                    <Image Source="{SvgImage /Assets/Icons/lua-logo.svg}"
                                           Width="28" Height="28"
                                           IsVisible="{Binding IsLua}" />
                                    <i:Icon Value="{Binding LanguageIcon}" FontSize="28"
                                            VerticalAlignment="Top"
                                            IsVisible="{Binding !IsSvgLanguage}" />
                                </Grid>
                                <StackPanel Grid.Column="1" Spacing="3">
                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Id}" Opacity="0.58" />
                                     <StackPanel Orientation="Horizontal" Spacing="8">
                                          <TextBlock Text="{Binding Language}" Opacity="0.68" />
                                          <TextBlock Text="{Binding ScopeLabel}" Opacity="0.68" />
                                       </StackPanel>
                                     <TextBlock Text="{Binding Status}" Opacity="0.78" />
                                 </StackPanel>
                                  <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                                       <Button Content="执行" MinWidth="54"
                                            Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).RunScriptCommand}"
                                            CommandParameter="{Binding}"
                                            IsVisible="{Binding IsRunnable}" />
                                      <Button Content="删除" MinWidth="54"
                                              Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).DeleteScriptCommand}"
                                              CommandParameter="{Binding}" />
                                  </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding ShowEmptyState}">
                    <TextBlock Text="还没有脚本" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="将脚本放入脚本目录后点击重新加载。" Opacity="0.68"
                               HorizontalAlignment="Center" />
                    <Button Content="打开脚本目录" Command="{Binding OpenScriptsFolderCommand}"
                            HorizontalAlignment="Center" />
                </StackPanel>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                            IsVisible="{Binding ShowNoResultsState}">
                    <TextBlock Text="没有匹配的脚本" FontSize="20" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="尝试调整搜索关键词或筛选条件。" Opacity="0.68"
                               HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Height="3" VerticalAlignment="Top"
                             IsVisible="{Binding Loading}" />
            </Grid>

            <TabControl Grid.Column="1">
                <TabItem Header="概览">
                    <ScrollViewer>
                    <StackPanel Margin="8" Spacing="8">
                        <TextBlock Text="{Binding SelectedScript.Name}" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedScript.Id}" Opacity="0.58" />
                        <TextBlock Text="{Binding SelectedScript.Language}" Opacity="0.68" />
                        <TextBlock Text="{Binding SelectedScript.ScopeLabel}" Opacity="0.68" />
                        <TextBlock Text="{Binding SelectedScript.EntryKindLabel}" Opacity="0.68" />
                        <TextBlock Text="{Binding SelectedScript.Status}" />
                         <TextBlock Text="{Binding SelectedScript.SourcePath}" TextWrapping="Wrap" Opacity="0.68" />
                         <TextBlock Text="{Binding SelectedScript.Description}" TextWrapping="Wrap" />
                         <TextBlock Text="{Binding SelectedScript.CapabilityLabel}" Opacity="0.68" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="打开源码" Command="{Binding OpenSelectedScriptCommand}"
                                    IsEnabled="{Binding CanOpenSelectedScript}" />
                            <Button Content="打开目录" Command="{Binding OpenScriptsFolderCommand}" />
                            <Button Content="重新检查" Command="{Binding ReloadCommand}"
                                    IsEnabled="{Binding CanReload}" />
                        </StackPanel>
                        <Border Classes="Card" Padding="12" IsVisible="{Binding CanOpenSelectedScript}">
                            <StackPanel Spacing="6">
                                <TextBlock Text="metadata 设置" FontWeight="SemiBold" />
                                <TextBlock Text="名称" />
                                <TextBox Text="{Binding MetadataName, Mode=TwoWay}" />
                                <TextBlock Text="描述" />
                                <TextBox Text="{Binding MetadataDescription, Mode=TwoWay}" AcceptsReturn="True"
                                         TextWrapping="Wrap" Height="56" />
                                <StackPanel Spacing="4" IsVisible="{Binding SelectedScript.IsAutomation}">
                                    <TextBlock Text="调度时间" />
                                    <TextBox Text="{Binding AutomationScheduleText, Mode=TwoWay}"
                                             Watermark="daily 09:00" />
                                    <TextBlock Text="格式 daily HH:mm；留空表示不定时。" FontSize="12" Opacity="0.6" />
                                    <CheckBox Content="应用启动后补跑一轮" IsChecked="{Binding AutomationRunOnStartup, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="保存" Classes="Primary" Command="{Binding SaveMetadataSettingsCommand}"
                                            IsEnabled="{Binding CanSaveMetadataSettings}" />
                                </StackPanel>
                                <TextBlock Text="{Binding MetadataSettingsError}" Foreground="IndianRed"
                                           TextWrapping="Wrap" IsVisible="{Binding HasMetadataSettingsError}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="诊断详情">
                    <Grid RowDefinitions="Auto,*">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button Content="复制诊断" Command="{Binding CopySelectedDiagnosticsCommand}"
                                    IsEnabled="{Binding HasSelectedDiagnostics}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1">
                            <Grid>
                            <ItemsControl ItemsSource="{Binding SelectedScript.DiagnosticDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ScriptDiagnosticListItem">
                                        <StackPanel Margin="4" Spacing="2">
                                            <TextBlock Text="{Binding SeverityLabel}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="没有诊断信息" Opacity="0.68"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding !HasSelectedDiagnostics}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="启动诊断">
                    <Grid RowDefinitions="Auto,*">
                        <Button Content="复制启动诊断" HorizontalAlignment="Right"
                                Command="{Binding CopyStartupDiagnosticsCommand}"
                                IsEnabled="{Binding HasStartupDiagnostics}" />
                        <ScrollViewer Grid.Row="1">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding StartupDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptDiagnosticListItem">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="没有启动诊断" Opacity="0.68"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasStartupDiagnostics}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="目录诊断">
                    <Grid RowDefinitions="Auto,*">
                        <Button Content="复制目录诊断" HorizontalAlignment="Right"
                                Command="{Binding CopyDirectoryDiagnosticsCommand}"
                                IsEnabled="{Binding HasDirectoryDiagnostics}" />
                        <ScrollViewer Grid.Row="1">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding DirectoryDiagnostics}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptDiagnosticListItem">
                                            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="没有目录诊断" Opacity="0.68"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasDirectoryDiagnostics}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="执行历史">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox Width="130" ItemsSource="{Binding HistoryStatusFilters}"
                                      SelectedItem="{Binding SelectedHistoryStatusFilter, Mode=TwoWay}" />
                            <ComboBox Width="130" ItemsSource="{Binding HistorySourceFilters}"
                                      SelectedItem="{Binding SelectedHistorySourceFilter, Mode=TwoWay}" />
                            <Button Content="清空历史" Command="{Binding ClearExecutionHistoryCommand}" />
                        </StackPanel>
                    <ListBox Grid.Row="1" ItemsSource="{Binding VisibleHistory}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ScriptHistoryListItem">
                                <StackPanel Margin="4" Spacing="2">
                                    <TextBlock Text="{Binding ScriptName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ScriptId}" Opacity="0.58" />
                                    <TextBlock Text="{Binding StatusLabel}" />
                                    <TextBlock Text="{Binding SourceLabel}" Opacity="0.68" />
                                    <TextBlock Text="{Binding StartedAt}" Opacity="0.68" />
                                     <TextBlock Text="{Binding Duration}" Opacity="0.68" />
                                     <TextBlock Text="{Binding EffectsSummary}" IsVisible="{Binding HasEffects}" />
                                     <Button Content="复制日志" HorizontalAlignment="Right"
                                             Command="{Binding $parent[UserControl].((vm:ScriptManagementViewModel)DataContext).CopyHistoryLogCommand}"
                                             CommandParameter="{Binding}" />
                                     <ItemsControl ItemsSource="{Binding Diagnostics}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Grid>
                </TabItem>
                <TabItem Header="运行日志">
                    <Grid RowDefinitions="Auto,*" RowSpacing="8" Margin="8">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <TextBlock Text="当前会话的脚本日志" Opacity="0.68" VerticalAlignment="Center" />
                            <Button Content="清空日志" Command="{Binding ClearScriptLogsCommand}"
                                    IsEnabled="{Binding HasScriptLogs}" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                            <Grid>
                                <ItemsControl ItemsSource="{Binding ScriptLogs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ScriptLogEntry">
                                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" Margin="2"
                                                       FontFamily="Cascadia Code,Consolas,Menlo,Monospace" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="暂无脚本运行日志" Opacity="0.68"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           IsVisible="{Binding !HasScriptLogs}" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="API Reference">
                    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8" Margin="8">
                        <Grid ColumnDefinitions="Auto,160,*,Auto" ColumnSpacing="8">
                            <TextBlock Text="脚本语言" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ApiReference.Languages}"
                                      SelectedItem="{Binding ApiReference.SelectedLanguage, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding ApiReference.Title}"
                                       VerticalAlignment="Center" FontWeight="SemiBold" />
                            <Button Grid.Column="3" Content="打开完整文档"
                                    Command="{Binding ApiReference.OpenReferenceCommand}"
                                    IsEnabled="{Binding ApiReference.HasReference}" />
                        </Grid>
                        <Border Grid.Row="1" Padding="8" CornerRadius="6"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                IsVisible="{Binding ApiReference.HasError}">
                            <TextBlock Text="{Binding ApiReference.Error}" Foreground="IndianRed"
                                       TextWrapping="Wrap" />
                        </Border>
                        <Grid Grid.Row="2">
                            <ScrollViewer>
                                <ItemsControl ItemsSource="{Binding ApiReference.Blocks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ScriptApiReferenceBlock">
                                            <StackPanel Spacing="6" Margin="0,0,0,14">
                                                <TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}"
                                                           FontWeight="{Binding FontWeight}" TextWrapping="Wrap"
                                                           IsVisible="{Binding IsHeading}" />
                                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                                                           IsVisible="{Binding IsParagraph}" />
                                                <Border Padding="10" CornerRadius="5"
                                                        Background="{DynamicResource TextControlBackgroundUnfocused}"
                                                        IsVisible="{Binding IsCode}">
                                                    <TextBlock Text="{Binding Text}" TextWrapping="NoWrap"
                                                               FontFamily="Cascadia Code,Consolas,Menlo,Monospace" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Text="{Binding ApiReference.Status}" Opacity="0.68"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding ApiReference.HasNoReference}" />
                        </Grid>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                        IsVisible="{Binding HasProgress}">
                <ProgressBar Width="180" Minimum="0" Maximum="1" Value="{Binding ProgressFraction}" />
                <TextBlock Text="{Binding ProgressMessage}" Opacity="0.8" MaxWidth="240"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsExecuting}" />
            <Button Content="运行" Command="{Binding RunCommand}" Classes="Primary" />
        </StackPanel>
    </Grid>
</UserControl>
