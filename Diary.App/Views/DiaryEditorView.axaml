<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:base="clr-namespace:Diary.Core.Data.Base;assembly=Diary.Core"
             xmlns:app="clr-namespace:Diary.App"
             xmlns:models="clr-namespace:Diary.Core.Data.App;assembly=Diary.Core"
             x:Class="Diary.App.Views.DiaryEditorView"
             x:DataType="viewModels:DiaryEditorViewModel">

    <Design.DataContext>
        <viewModels:DiaryEditorViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Style Selector="^:selected > Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCardCheckedBorderBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.CompactCalendarNavigation">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="4" />
        </Style>
        <Style Selector="Button.CompactCalendarHeader">
            <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.CompactCalendarWeekday">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.CompactCalendarDay">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorTertiaryActive}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.CompactCalendarDay.OutsideMonth">
            <Setter Property="Opacity" Value="0.52" />
        </Style>
        <Style Selector="Button.CompactCalendarDay.Today">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.CompactCalendarDay.Selected">
            <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    MaxWidth="560"
                    IsVisible="{Binding !DatabaseOk, Source={x:Static app:App.Instance}}">
            <TextBlock Text="数据库连接不可用" Classes="EmptyStateTitle" />
            <TextBlock Text="{Binding DatabaseStatusMessage, Source={x:Static app:App.Instance}}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="本地记录不会因为连接失败被删除。恢复连接后即可继续查看和编辑。"
                       Classes="EmptyStateDescription" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="重试连接" Command="{Binding RetryDatabaseConnectionCommand}" Classes="Primary" />
                <Button Content="打开数据库设置" Command="{Binding OpenDatabaseSettingsCommand}" />
                <Button Content="导出诊断日志" Command="{Binding ExportDiagnosticsCommand}" />
            </StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="320,1,*" ColumnSpacing="12" Margin="8"
              IsVisible="{Binding DatabaseOk, Source={x:Static app:App.Instance}}">
            <!-- 左侧是日期和项目列表展示 -->
            <Border Classes="MasterPane">
            <DockPanel VerticalSpacing="10">
                <StackPanel DockPanel.Dock="Top" Spacing="8">
                    <StackPanel Name="DiaryDateHeading" Spacing="2">
                        <TextBlock Name="DiaryDateTitle"
                                   Text="{Binding SelectedDate, StringFormat='{}{0:yyyy年M月d日}'}"
                                   Classes="SectionTitle" />
                        <TextBlock Name="DiaryDateDescription"
                                   Text="选择日期并管理当天的工作记录"
                                   TextWrapping="NoWrap" Classes="SectionDescription" />
                    </StackPanel>
                    <StackPanel Name="DiaryDateActions" Orientation="Horizontal" Spacing="6">
                        <Button Content="回到今天"
                                HotKey="Ctrl+T" Classes="ActionButton"
                                Command="{Binding SelectTodayCommand}" />
                        <Button Content="复制记录" Classes="ActionButton"
                                ToolTip.Tip="选择复制昨天、最近记录或整天记录">
                            <Button.Flyout>
                                <MenuFlyout ShowMode="Transient">
                                    <MenuItem Header="复制昨天"
                                              Command="{Binding CopyPreviousDayCommand}" />
                                    <MenuItem Header="复制最近"
                                              ToolTip.Tip="复制当前日期之前近一年内的最近一条记录"
                                              Command="{Binding CopyRecentWorkItemCommand}" />
                                    <MenuItem Header="复制整天"
                                              Command="{Binding CopyWholeDayCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                </StackPanel>
                <Border Name="CompactCalendar" DockPanel.Dock="Top" Classes="SubtleCard" Padding="8"
                        PointerWheelChanged="OnCompactCalendarPointerWheelChanged">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4">
                            <Button Name="PreviousCalendarPeriodButton" Classes="CompactCalendarNavigation"
                                    ToolTip.Tip="显示上一周期" Command="{Binding ShowPreviousCalendarPeriodCommand}">
                                <i:Icon Value="mdi-chevron-left" FontSize="18" />
                            </Button>
                            <Button Name="CompactCalendarHeader" Grid.Column="1" Classes="CompactCalendarHeader"
                                    Content="{Binding CompactCalendarTitle}"
                                    ToolTip.Tip="左键打开完整月历，右键显示月、季度和年度操作"
                                    ContextRequested="OnCompactCalendarHeaderContextRequested">
                                <Button.ContextMenu>
                                    <ContextMenu ItemsSource="{Binding QuickMenuItems}">
                                        <ContextMenu.ItemContainerTheme>
                                            <ControlTheme TargetType="MenuItem"
                                                          BasedOn="{StaticResource {x:Type MenuItem}}"
                                                          x:DataType="viewModels:DayMenuItem">
                                                <Setter Property="Header" Value="{Binding Header}" />
                                                <Setter Property="Command" Value="{Binding Command}" />
                                                <Setter Property="CommandParameter" Value="{Binding}" />
                                                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                                <Setter Property="ItemsSource" Value="{Binding Children}" />
                                            </ControlTheme>
                                        </ContextMenu.ItemContainerTheme>
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <Button.Flyout>
                                    <Flyout ShowMode="Standard" PlacementGravity="Bottom">
                                        <Calendar Name="DiaryCalendar" FirstDayOfWeek="Monday"
                                                  Width="292" Height="285"
                                                  IsTodayHighlighted="True" SelectionMode="SingleDate"
                                                  DisplayDate="{Binding CompactCalendarAnchorDate}"
                                                  SelectedDate="{Binding SelectedDate}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Name="NextCalendarPeriodButton" Grid.Column="2"
                                    Classes="CompactCalendarNavigation"
                                    ToolTip.Tip="显示下一周期" Command="{Binding ShowNextCalendarPeriodCommand}">
                                <i:Icon Value="mdi-chevron-right" FontSize="18" />
                            </Button>
                        </Grid>
                        <UniformGrid Columns="7">
                            <TextBlock Text="一" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="二" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="三" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="四" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="五" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="六" Classes="CompactCalendarWeekday" />
                            <TextBlock Text="日" Classes="CompactCalendarWeekday" />
                        </UniformGrid>
                        <ItemsControl Name="CompactCalendarDays" ItemsSource="{Binding CompactCalendarDays}"
                                      Focusable="True" KeyDown="OnCompactCalendarKeyDown">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="viewModels:CompactCalendarDay">
                                    <Button Classes="CompactCalendarDay"
                                            Classes.Selected="{Binding IsSelected}"
                                            Classes.Primary="{Binding IsSelected}"
                                            Classes.Today="{Binding IsToday}"
                                            Classes.OutsideMonth="{Binding IsOutsideMonth}"
                                            Content="{Binding DayText}" ToolTip.Tip="{Binding ToolTip}"
                                            Command="{Binding $parent[UserControl].((viewModels:DiaryEditorViewModel)DataContext).SelectCompactCalendarDateCommand}"
                                            CommandParameter="{Binding Date}"
                                            ContextRequested="OnCompactCalendarDayContextRequested"
                                            Click="OnCompactCalendarDayClick">
                                        <Button.ContextMenu>
                                            <ContextMenu ItemsSource="{Binding $parent[UserControl].((viewModels:DiaryEditorViewModel)DataContext).QuickMenuItems}">
                                                <ContextMenu.ItemContainerTheme>
                                                    <ControlTheme TargetType="MenuItem"
                                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                  x:DataType="viewModels:DayMenuItem">
                                                        <Setter Property="Header" Value="{Binding Header}" />
                                                        <Setter Property="Command" Value="{Binding Command}" />
                                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                                        <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                                        <Setter Property="ItemsSource" Value="{Binding Children}" />
                                                    </ControlTheme>
                                                </ContextMenu.ItemContainerTheme>
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <!-- 统计信息 -->
                <Border DockPanel.Dock="Bottom" Classes="SubtleCard" Padding="10,8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding TotalTime, StringFormat='当天合计 {0:0.##} 小时'}"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding UploadedTime, StringFormat='已同步 {0:0.##} 小时'}"
                                   Opacity="0.68" />
                    </StackPanel>
                    <Button Command="{Binding UploadAllCommand}" HotKey="Ctrl+Shift+U"
                            Grid.Column="1" Classes="ActionButton">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <i:Icon Value="mdi-cloud-upload-outline" FontSize="14" />
                            <TextBlock Text="同步当天" />
                        </StackPanel>
                    </Button>
                </Grid>
                </Border>
                <ScrollViewer>
                    <ListBox ItemsSource="{Binding DailyWorks}"
                             VerticalAlignment="Stretch" Name="DailyItemList"
                             SelectionMode="Single" SelectedItem="{Binding SelectedWork}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:WorkEditorViewModel}">
                                <Border Theme="{DynamicResource CardBorder}" Padding="8,6"
                                        CornerRadius="6" ToolTip.Placement="Pointer" ToolTip.HorizontalOffset="48"
                                        ToolTip.Tip="{Binding Comment}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="脚本" ItemsSource="{Binding EditorScriptActions}">
                                                <MenuItem.ItemContainerTheme>
                                                    <ControlTheme TargetType="MenuItem"
                                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                  x:DataType="viewModels:WorkEditorScriptMenuItem">
                                                        <Setter Property="Header" Value="{Binding Header}" />
                                                        <Setter Property="Command" Value="{Binding Command}" />
                                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                    </ControlTheme>
                                                </MenuItem.ItemContainerTheme>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="Auto,*,Auto"
                                          RowSpacing="6" ColumnSpacing="8">
                                        <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="{DynamicResource SemiColorFill2}"
                                                CornerRadius="4" Margin="-4 0" />
                                        <TextBlock Grid.Row="0" Grid.Column="0"
                                                   Text="{Binding WorkId, StringFormat='#{0}'}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Comment}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Row="0" Grid.Column="2" Padding="6 2" CornerRadius="4"
                                                Background="{DynamicResource ButtonDefaultBackground}">
                                            <TextBlock Text="{Binding Priority}" FontWeight="SemiBold" />
                                        </Border>

                                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                                    Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Time, StringFormat='{}{0:0.#} 小时'}" />
                                            <TextBlock Text="·" Opacity="0.5" />
                                            <!-- 标签颜色 -->
                                            <ItemsControl ItemsSource="{Binding WorkTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="2" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="base:WorkTag">
                                                        <Border Width="16" Height="16" BorderThickness="0" ToolTip.Placement="Top" ToolTip.VerticalOffset="-8"
                                                                CornerRadius="3" ToolTip.Tip="{Binding Name}"
                                                                Background="{Binding Color, Converter={StaticResource IntColor}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                                                    Orientation="Horizontal" Spacing="4">
                                            <i:Icon Value="mdi-content-save-outline" FontSize="16" />
                                            <TextBlock Text="{Binding StatusSummary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource GridSplitterBackground}"
                    CornerRadius="0" />
            <!-- 右侧是编辑区 -->
            <Border Grid.Column="2" Classes="DetailPane" Padding="12">
            <DockPanel VerticalSpacing="10">
                <Border DockPanel.Dock="Top" Classes="WorkspaceToolbar">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8">
                    <Button Name="NewWorkItemButton" Classes="ActionButton" Content="新建事项" HotKey="Ctrl+N"
                            Command="{Binding NewWorkItemCommand}" />
                    <!-- TODO: add flyout for next button -->
                    <Button Name="NewFromTemplateButton" Grid.Column="1" Classes="ActionButton"
                            Content="从模板新建" HotKey="Ctrl+Shift+N"
                            IsEnabled="{Binding CanUseTemplates}">
                        <Button.Flyout>
                            <MenuFlyout ShowMode="Transient" ItemsSource="{Binding Templates}">
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="models:Template">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="Command" Value="{Binding $parent[Button].((viewModels:DiaryEditorViewModel)DataContext).NewWithTemplateCommand}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Grid.Column="2" Classes="Primary ActionButton" Content="保存" HotKey="Ctrl+S"
                            Command="{Binding SaveWorkItemCommand}" />
                    <Button Grid.Column="3" Classes="ActionButton" Content="重复当前事项" HotKey="Ctrl+D"
                            Command="{Binding DuplicateWorkItemCommand}" />
                    <Button Grid.Column="4" Classes="Danger ActionButton" Content="删除当前项" HotKey="Ctrl+Shift+D"
                            Command="{Binding DeleteWorkItemCommand}" />
                    <Button Grid.Column="5" Classes="ActionButton" Content="同步工时" HotKey="Ctrl+U"
                            Command="{Binding UploadTimeCommand}" />
                    <Border Name="SelectedWorkStatusPill" Grid.Column="6" Classes="StatusPill"
                            HorizontalAlignment="Right" IsVisible="{Binding HasItem}">
                        <TextBlock Text="{Binding SelectedWork.StatusSummary}" HorizontalAlignment="Center" />
                    </Border>
                </Grid>
                </Border>
                <Panel>
                    <TextBlock Text="当前未选中任何事项" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ButtonDefaultDisabledForeground}"
                               IsVisible="{Binding !HasItem}" VerticalAlignment="Center" />
                    <ScrollViewer IsVisible="{Binding HasItem}" VerticalScrollBarVisibility="Auto">
                        <ContentControl Content="{Binding SelectedWork}" />
                    </ScrollViewer>
                </Panel>
            </DockPanel>
            </Border>
        </Grid>
    </Panel>
</UserControl>
