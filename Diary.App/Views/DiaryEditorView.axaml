<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:base="clr-namespace:Diary.Core.Data.Base;assembly=Diary.Core"
             xmlns:app="clr-namespace:Diary.App"
             xmlns:models="clr-namespace:Diary.Core.Data.App;assembly=Diary.Core"
             x:Class="Diary.App.Views.DiaryEditorView"
             x:DataType="viewModels:DiaryEditorViewModel">

    <Design.DataContext>
        <viewModels:DiaryEditorViewModel />
    </Design.DataContext>

    <UserControl.Styles>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2" />
            <Style Selector="^:selected > Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CheckBoxCardCheckedBorderBrush}" />
            </Style>
            <Style Selector="^:selected">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Panel>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14"
                    MaxWidth="560"
                    IsVisible="{Binding !DatabaseOk, Source={x:Static app:App.Instance}}">
            <TextBlock Text="数据库连接不可用" HorizontalAlignment="Center" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="{Binding DatabaseStatusMessage, Source={x:Static app:App.Instance}}"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock Text="本地记录不会因为连接失败被删除。恢复连接后即可继续查看和编辑。"
                       HorizontalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                <Button Content="重试连接" Command="{Binding RetryDatabaseConnectionCommand}" Classes="Primary" />
                <Button Content="打开数据库设置" Command="{Binding OpenDatabaseSettingsCommand}" />
                <Button Content="导出诊断日志" Command="{Binding ExportDiagnosticsCommand}" />
            </StackPanel>
        </StackPanel>
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="4"
              IsVisible="{Binding DatabaseOk, Source={x:Static app:App.Instance}}">
            <!-- 左侧是日期和项目列表展示 -->
            <DockPanel VerticalSpacing="8" Width="280">
                <Grid ColumnSpacing="8" ColumnDefinitions="Auto,*,Auto" HorizontalAlignment="Stretch"
                      DockPanel.Dock="Top">
                    <TextBlock Text="日期选择" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Content="回到今天"
                            HotKey="Ctrl+T" Classes="ActionButton"
                            Command="{Binding SelectTodayCommand}" />
                </Grid>
                <Separator DockPanel.Dock="Top" />
                <Calendar FirstDayOfWeek="Monday" DockPanel.Dock="Top"
                          IsTodayHighlighted="True" SelectionMode="SingleDate"
                          DisplayDate="{Binding CurrentDate}"
                          SelectedDate="{Binding SelectedDate}"
                          ContextRequested="OnCalendarContextRequested">
                    <Calendar.ContextMenu>
                        <ContextMenu ItemsSource="{Binding QuickMenuItems}">
                            <ContextMenu.ItemContainerTheme>
                                <ControlTheme TargetType="MenuItem"
                                              BasedOn="{StaticResource {x:Type MenuItem}}"
                                              x:DataType="viewModels:DayMenuItem">
                                        <Setter Property="Header" Value="{Binding Header}" />
                                        <Setter Property="Command"
                                                Value="{Binding Command}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                        <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                        <Setter Property="ItemsSource" Value="{Binding Children}" />
                                    </ControlTheme>
                            </ContextMenu.ItemContainerTheme>
                        </ContextMenu>
                    </Calendar.ContextMenu>
                </Calendar>
                <Separator DockPanel.Dock="Top" />
                <!-- 统计信息 -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" Spacing="8">
                    <TextBlock Text="{Binding TotalTime, StringFormat='总共 {0:0.##} 小时'}" />
                    <TextBlock Text="{Binding UploadedTime, StringFormat='提交 {0:0.##} 小时'}" />
                    <Button Command="{Binding UploadAllCommand}" HotKey="Ctrl+Shift+U"
                            Classes="ActionButton">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <i:Icon Value="mdi-cloud-upload-outline" FontSize="14" />
                            <TextBlock Text="提交" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <ScrollViewer>
                    <ListBox ItemsSource="{Binding DailyWorks}"
                             VerticalAlignment="Stretch" Name="DailyItemList"
                             SelectionMode="Single" SelectedItem="{Binding SelectedWork}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type viewModels:WorkEditorViewModel}">
                                <Border Theme="{DynamicResource CardBorder}" Padding="4"
                                        CornerRadius="6"
                                        ToolTip.Tip="{Binding Comment}">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="脚本" ItemsSource="{Binding EditorScriptActions}">
                                                <MenuItem.ItemContainerTheme>
                                                    <ControlTheme TargetType="MenuItem"
                                                                  BasedOn="{StaticResource {x:Type MenuItem}}"
                                                                  x:DataType="viewModels:WorkEditorScriptMenuItem">
                                                        <Setter Property="Header" Value="{Binding Header}" />
                                                        <Setter Property="Command" Value="{Binding Command}" />
                                                        <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                    </ControlTheme>
                                                </MenuItem.ItemContainerTheme>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <StackPanel Orientation="Vertical" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding WorkId, StringFormat='#{0}'}" />
                                            <TextBlock Text="{Binding Comment}" />
                                        </StackPanel>
                                        <Separator />
                                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Time,StringFormat='{}{0:0.#} 小时'}" />
                                            <TextBlock Text="{Binding Priority}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                            <!-- 标签颜色 -->
                                            <ItemsControl ItemsSource="{Binding WorkTags}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" Spacing="1" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="base:WorkTag">
                                                        <Border Width="20" Height="20" BorderThickness="0"
                                                                CornerRadius="4" ToolTip.Tip="{Binding Name}"
                                                                Background="{Binding Color, Converter={StaticResource IntColor}}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- 本地保存和远程上传状态 -->
                                            <StackPanel Orientation="Horizontal" Spacing="2">
                                                <i:Icon Value="mdi-content-save-outline" FontSize="18" />
                                                <TextBlock Text="{Binding LocalSaveStatusText}" />
                                            </StackPanel>
                                            <TextBlock Text="·" Opacity="0.6" />
                                            <TextBlock Text="{Binding UploadStatusText}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>
            </DockPanel>
            <Border Grid.Column="1" BorderThickness="1" BorderBrush="{DynamicResource GridSplitterBackground}"
                    CornerRadius="0" Margin="0 42 0 0" />
            <!-- 右侧是编辑区 -->
            <DockPanel Grid.Column="2" VerticalSpacing="8">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0">
                    <Button Classes="ActionButton" Content="新建事项" HotKey="Ctrl+N"
                            Command="{Binding NewWorkItemCommand}" />
                    <!-- TODO: add flyout for next button -->
                    <Button Classes="ActionButton" Content="从模板新建" HotKey="Ctrl+Shift+N"
                            IsEnabled="{Binding CanUseTemplates}">
                        <Button.Flyout>
                            <MenuFlyout ShowMode="Transient" ItemsSource="{Binding Templates}">
                                <MenuFlyout.ItemContainerTheme>
                                    <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"
                                                  x:DataType="models:Template">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="Command" Value="{Binding $parent[Button].((viewModels:DiaryEditorViewModel)DataContext).NewWithTemplateCommand}"/>
                                        <Setter Property="CommandParameter" Value="{Binding}"/>
                                    </ControlTheme>
                                </MenuFlyout.ItemContainerTheme>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <Button Classes="ActionButton" Content="保存" HotKey="Ctrl+S"
                            Command="{Binding SaveWorkItemCommand}" />
                    <Button Classes="ActionButton" Content="重复当前事项" HotKey="Ctrl+D"
                            Command="{Binding DuplicateWorkItemCommand}" />
                    <Button Classes="ActionButton" Content="删除当前项" HotKey="Ctrl+Shift+D"
                            Command="{Binding DeleteWorkItemCommand}" />
                    <Button Classes="ActionButton" Content="提交工时" HotKey="Ctrl+U"
                            Command="{Binding UploadTimeCommand}" />
                </StackPanel>
                <Separator DockPanel.Dock="Top" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding SelectedWork.StatusSummary}" Opacity="0.7" />
                <Panel>
                    <TextBlock Text="当前未选中任何事项" FontSize="48" HorizontalAlignment="Center"
                               Foreground="{DynamicResource ButtonDefaultDisabledForeground}"
                               IsVisible="{Binding !HasItem}" VerticalAlignment="Center" />
                    <ContentControl IsVisible="{Binding HasItem}" Content="{Binding SelectedWork}" />
                </Panel>
            </DockPanel>
        </Grid>
    </Panel>
</UserControl>
