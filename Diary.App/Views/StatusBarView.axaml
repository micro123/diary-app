<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diary.App.Views.StatusBarView"
             x:DataType="viewModels:StatusBarViewModel"
             Height="34">
    <Design.DataContext>
        <viewModels:StatusBarViewModel/>
    </Design.DataContext>
    <Border Background="{DynamicResource WindowDefaultBackground}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0 1 0 0">
        <DockPanel Margin="8 0">
            <DockPanel.Styles>
                <Style Selector="Button.StatusItem">
                    <Setter Property="Theme" Value="{DynamicResource BorderlessButton}" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="MinWidth" Value="28" />
                    <Setter Property="Padding" Value="8 2" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style Selector="^:pointerover">
                        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
                    </Style>
                </Style>
                <Style Selector="Button.StatusItem StackPanel">
                    <Setter Property="Spacing" Value="5" />
                </Style>
                <Style Selector="Button.StatusItem i|Icon">
                    <Setter Property="FontSize" Value="16" />
                </Style>
                <Style Selector="Button.StatusItem TextBlock">
                    <Setter Property="FontSize" Value="12" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                </Style>
            </DockPanel.Styles>

            <Button DockPanel.Dock="Left" Classes="StatusItem"
                    ToolTip.Tip="查看源代码" Command="{Binding OpenSourceUrlCommand}">
                <i:Icon Value="mdi-github" />
            </Button>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2">
                <Button Classes="StatusItem" ToolTip.Tip="查看后台任务"
                        IsVisible="{Binding HasTasks}">
                    <!-- TODO: 添加任务进度预览 -->
                    <i:Icon Value="mdi-gauge" />
                </Button>
                <Border Width="1" Height="16" Margin="4 0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource SemiColorBorder}"
                        IsVisible="{Binding HasTasks}" />
                <Button Classes="StatusItem" ToolTip.Tip="用户名">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-account-outline" />
                        <TextBlock Text="{Binding UserName}" />
                    </StackPanel>
                </Button>
                <Button Classes="StatusItem" ToolTip.Tip="计算机名称">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-desktop-classic" />
                        <TextBlock Text="{Binding ComputerName}" />
                    </StackPanel>
                </Button>
                <Button Classes="StatusItem" ToolTip.Tip="当前日期">
                    <StackPanel Orientation="Horizontal">
                        <i:Icon Value="mdi-calendar-month-outline" />
                        <TextBlock Text="{Binding Date}" />
                    </StackPanel>
                    <Button.Flyout>
                        <Flyout ShowMode="Standard" PlacementGravity="BottomLeft">
                            <Calendar SelectionMode="None" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>

            <Rectangle />
        </DockPanel>
    </Border>
</UserControl>
