<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             x:Class="Diary.App.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel"
             Width="800" Height="680" Margin="8 28 8 8" Padding="8">
    <Design.DataContext>
        <viewModels:SettingsViewModel/>
    </Design.DataContext>

    <!-- 内容：DataTemplate 由 Application.DataTemplates 提供 (App.axaml)，与 GenericConfigView 共享 -->
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="程序设置" Classes="PageTitle" />
                <TextBlock Grid.Column="1" Text="界面、工作流、数据库、更新与 AI" Classes="PageSubtitle" />
            </Grid>
        </Border>
        <Border Grid.Row="1" Classes="DetailPane" Padding="6" ClipToBounds="True">
            <ItemsControl Classes="Settings" MinHeight="0"
                          ItemsSource="{Binding SettingsTree.Children}" />
        </Border>
        <StackPanel Grid.Row="2" Classes="DialogFooter">
            <Button Content="打开当前日志" Command="{Binding OpenCurrentLogCommand}" />
            <Button Content="导出日志" Command="{Binding ExportLogsCommand}" />
            <Button Content="关闭" Command="{Binding LoadCommand}" />
            <Button Classes="Primary" Content="保存" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
