<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             x:Class="Diary.App.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel"
             Padding="8">
    <Design.DataContext>
        <viewModels:SettingsViewModel/>
    </Design.DataContext>

    <!-- 内容：DataTemplate 由 Application.DataTemplates 提供 (App.axaml)，与 GenericConfigView 共享 -->
    <Grid RowDefinitions="*,Auto">
        <ScrollViewer>
            <StackPanel Spacing="16">
                <ItemsControl Classes="Settings" ItemsSource="{Binding SettingsTree.Children}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="16"
                    Margin="32  8 32 0">
            <Button Classes="Large" Content="Tracker 配置"
                    Command="{Binding ShowTrackerSettingsCommand}" />
            <Button Classes="Large" Content="Tracker 插件状态"
                    Command="{Binding ShowTrackerDiagnosticsCommand}" />
            <Button Classes="Large" Content="导出日志" Command="{Binding ExportLogsCommand}" />
            <Button Classes="Large Danger" Content="还原配置" Command="{Binding LoadCommand}" />
            <Button Classes="Large Primary" Content="保存配置" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
