<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             x:Class="Diary.App.Views.SettingsView"
             x:DataType="viewModels:SettingsViewModel"
             Padding="8">
    <Design.DataContext>
        <viewModels:SettingsViewModel/>
    </Design.DataContext>

    <!-- 一些事件 -->
    <Interaction.Behaviors>
        <EventTriggerBehavior EventName="Loaded">
            <InvokeCommandAction Command="{Binding ForceLoadCommand}" />
        </EventTriggerBehavior>
    </Interaction.Behaviors>

    <!-- 内容：DataTemplate 由 Application.DataTemplates 提供 (App.axaml)，与 GenericConfigView 共享 -->
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Padding="8" Margin="0 0 0 8" Background="#12000000">
            <StackPanel Spacing="6">
                <TextBlock Text="Tracker 插件状态" FontSize="16" FontWeight="SemiBold" />
                <ScrollViewer MaxHeight="220">
                    <ItemsControl ItemsSource="{Binding PluginDiagnostics}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto"
                                      Margin="0 4">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding PluginId}" Opacity="0.7" />
                                        <TextBlock Text="{Binding PluginVersion}" Opacity="0.7" />
                                        <TextBlock Text="{Binding PluginState}" />
                                        <TextBlock Text="{Binding InstanceId}" />
                                        <TextBlock Text="{Binding InstanceState}" />
                                        <TextBlock Text="{Binding Error}" Foreground="IndianRed"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="重试" Command="{Binding RetryCommand}"
                                            IsVisible="{Binding CanRetry}" VerticalAlignment="Center"
                                            Margin="12 0 0 0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
        <ItemsControl Grid.Row="1" Classes="Settings" ItemsSource="{Binding SettingsTree.Children}"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Spacing="16"
                    Margin="32  8 32 0">
            <Button Classes="Large Danger" Content="还原配置" Command="{Binding LoadCommand}" />
            <Button Classes="Large Primary" Content="保存配置" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
