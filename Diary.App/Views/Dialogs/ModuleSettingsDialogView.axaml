<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             xmlns:moduleUi="clr-namespace:Diary.ModuleUI;assembly=Diary.ModuleUI"
             x:Class="Diary.App.Views.Dialogs.ModuleSettingsDialogView"
             x:DataType="dialogs:ModuleSettingsDialogViewModel"
             Width="1120" Height="740" MinWidth="900" MinHeight="620" Padding="10">
    <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="模块设置" Classes="PageTitle" />
                <TextBlock Grid.Column="1" Text="可选模块启停、启动诊断与模块配置" Classes="PageSubtitle" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Theme="{DynamicResource LineTabControl}">
            <TabItem Header="模块管理">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Margin="0,6,0,0">
                    <TextBlock Text="启用状态在下次启动时应用；当前已加载模块不会在本次运行中卸载。"
                               TextWrapping="Wrap" Opacity="0.7" />
                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Modules}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:ModuleStateItemViewModel">
                                    <Border Classes="SettingsCard" Margin="0,0,0,8" Padding="12">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                                            <StackPanel Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Opacity="0.65" />
                                                    <TextBlock Text="{Binding RuntimeStatus}" Opacity="0.65" />
                                                </StackPanel>
                                                <SelectableTextBlock Text="{Binding Id}" Opacity="0.65" />
                                                <TextBlock Text="{Binding DiagnosticMessage}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ChangeStatus}" TextWrapping="Wrap" Opacity="0.7" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Content="启用"
                                                      IsChecked="{Binding IsEnabled}"
                                                      VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="1" Text="未发现可选模块。" IsVisible="{Binding HasNoModules}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                    <Expander Grid.Row="2" Header="启动诊断">
                        <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="dialogs:ModuleDiagnosticItem">
                                    <StackPanel Margin="4" Spacing="2">
                                        <TextBlock Text="{Binding ModuleId}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding State, StringFormat='状态：{0}'}" />
                                        <TextBlock Text="{Binding Code, StringFormat='代码：{0}'}" Opacity="0.7" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>
                </Grid>
            </TabItem>

            <TabItem Header="模块配置">
                <Grid Margin="0,6,0,0" MinHeight="0">
                    <TabControl ItemsSource="{Binding SettingsPages}">
                        <TabControl.ItemTemplate>
                            <DataTemplate x:DataType="moduleUi:SettingsContributionPage">
                                <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.ContentTemplate>
                            <DataTemplate x:DataType="moduleUi:SettingsContributionPage">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ContentControl Content="{Binding ViewModel}" Margin="0,0,6,0" />
                                </ScrollViewer>
                            </DataTemplate>
                        </TabControl.ContentTemplate>
                    </TabControl>
                    <TextBlock Text="当前没有已加载模块提供配置页面。启用模块并重启后，其配置页会显示在这里。"
                               IsVisible="{Binding HasNoSettingsPages}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextWrapping="Wrap" Opacity="0.7" />
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Opacity="0.75" />
        <StackPanel Grid.Row="3" Classes="DialogFooter">
            <Button Content="关闭" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="保存模块状态" Command="{Binding SaveCommand}"
                    IsEnabled="{Binding CanSave}" />
        </StackPanel>
    </Grid>
</UserControl>
