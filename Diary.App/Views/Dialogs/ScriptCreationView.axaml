<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.ScriptCreationView"
             x:DataType="dialogs:ScriptCreationViewModel"
             MinWidth="520" MinHeight="520" MaxHeight="640" Padding="24">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <StackPanel Spacing="4">
            <TextBlock Text="新建脚本" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="创建一个可立即加载的脚本模板。" Opacity="0.68" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="12">
                <TextBlock Text="脚本名称" />
                <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="例如：每日摘要" />
                <TextBlock Text="稳定 ID" />
                <TextBox Text="{Binding Id, Mode=TwoWay}" Watermark="例如：daily-summary" />
                <TextBlock Text="只允许字母、数字、点、短横线和下划线，长度为 2-64 个字符且以字母开头。" FontSize="12" Opacity="0.6" />
                <TextBlock Text="脚本类型" />
                <ComboBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding SelectedScope, Mode=TwoWay}" />
                <TextBlock Text="脚本语言" />
                <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}" />
                <TextBlock Text="脚本样板" />
                <ComboBox ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate, Mode=TwoWay}" />
                <TextBlock Text="描述" />
                <TextBox Text="{Binding Description, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="70" />
                <StackPanel Spacing="4" IsVisible="{Binding IsAutomationTemplate}">
                    <TextBlock Text="调度时间" />
                    <TextBox Text="{Binding ScheduleText, Mode=TwoWay}" Watermark="daily 09:00" />
                    <TextBlock Text="格式 daily HH:mm，例如 daily 09:00；留空时请勾选启动补跑或至少一个事件触发。" FontSize="12" Opacity="0.6" />
                    <CheckBox Content="应用启动后补跑一轮" IsChecked="{Binding RunOnStartup, Mode=TwoWay}" />
                    <TextBlock Text="事件触发" />
                    <CheckBox Content="工作项创建后" IsChecked="{Binding TriggerOnWorkItemCreated, Mode=TwoWay}" />
                    <CheckBox Content="工作项保存后" IsChecked="{Binding TriggerOnWorkItemSaved, Mode=TwoWay}" />
                    <CheckBox Content="添加标签后" IsChecked="{Binding TriggerOnTagAdded, Mode=TwoWay}" />
                </StackPanel>
                <TextBlock Text="脚本默认拥有全部已实现的宿主 API，无需单独申请权限。" FontSize="12" Opacity="0.68" />
                <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap" IsVisible="{Binding HasError}" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="取消" Command="{Binding CloseCommand}" />
            <Button Content="创建" Classes="Primary" Command="{Binding CreateCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
