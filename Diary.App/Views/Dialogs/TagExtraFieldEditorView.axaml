<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             xmlns:models="clr-namespace:Diary.App.Models"
             mc:Ignorable="d"
             x:Class="Diary.App.Views.Dialogs.TagExtraFieldEditorView"
             x:Name="TagExtraFieldEditorRoot"
             x:DataType="dialogs:TagExtraFieldEditorViewModel"
             Width="520"
             MinHeight="460"
             Margin="8 24 8 8">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Title}" Classes="Header" />
            <TextBlock Text="字段值为可选项；FieldKey 和类型创建后不可修改。"
                       Opacity="0.72"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="6">
                <TextBlock Text="显示名称" />
                <TextBox Name="ExtraFieldLabelInput"
                         Text="{Binding Field.Label}"
                         Watermark="例如：参与人"
                         Classes="ClearButton" />

                <TextBlock Text="FieldKey" />
                <TextBox Name="ExtraFieldKeyInput"
                         Text="{Binding Field.FieldKey}"
                         IsEnabled="{Binding Field.IsNew}"
                         Watermark="例如：meeting.participants"
                         Classes="ClearButton" />
                <TextBlock Text="只能使用英文、数字、点、下划线和短横线。"
                           Opacity="0.65"
                           FontSize="12" />

                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Spacing="4">
                        <TextBlock Text="类型" />
                        <ComboBox Name="ExtraFieldTypeInput"
                                  ItemsSource="{Binding Field.AvailableTypes}"
                                  SelectedItem="{Binding Field.Type}"
                                  IsEnabled="{Binding Field.IsNew}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4" MinWidth="90">
                        <TextBlock Text="状态" />
                        <ToggleSwitch Name="ExtraFieldEnabledInput"
                                      IsChecked="{Binding Field.Enabled}"
                                      OnContent="启用"
                                      OffContent="停用" />
                    </StackPanel>
                </Grid>

                <StackPanel Spacing="4">
                    <TextBlock Text="说明" />
                    <TextBox Name="ExtraFieldDescriptionInput"
                             Text="{Binding Field.Description}"
                             Watermark="可选，用于 Tooltip 提示"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="64" />
                </StackPanel>

                <StackPanel Spacing="4" IsVisible="{Binding Field.IsChoice}">
                    <TextBlock Text="选项" />
                    <TextBox Name="ExtraFieldOptionsInput"
                             Text="{Binding Field.OptionsText}"
                             Watermark="每行填写一个选项"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="90" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Text="默认值" />
                    <ContentControl Content="{Binding Field.DefaultValueEditor}">
                        <ContentControl.DataTemplates>
                            <DataTemplate DataType="models:EditableWorkItemExtraField">
                                <Grid>
                                    <TextBox Name="ExtraFieldDefaultTextInput"
                                             IsVisible="{Binding UsesTextEditor}"
                                             Text="{Binding Value, Mode=TwoWay}"
                                             Watermark="不设置默认值" />
                                    <TextBox Name="ExtraFieldDefaultMultilineInput"
                                             IsVisible="{Binding UsesMultilineTextEditor}"
                                             Text="{Binding Value, Mode=TwoWay}"
                                             AcceptsReturn="True" TextWrapping="Wrap"
                                             MinHeight="64" Watermark="不设置默认值" />
                                    <NumericUpDown Name="ExtraFieldDefaultIntegerInput"
                                                   IsVisible="{Binding UsesIntegerEditor}"
                                                   Value="{Binding NumericValue, Mode=TwoWay}"
                                                   Minimum="-2147483648" Maximum="2147483647"
                                                   Increment="1" FormatString="0" ParsingNumberStyle="Integer"
                                                   Watermark="不设置默认值" />
                                    <NumericUpDown Name="ExtraFieldDefaultDecimalInput"
                                                   IsVisible="{Binding UsesDecimalEditor}"
                                                   Value="{Binding NumericValue, Mode=TwoWay}"
                                                   Increment="0.1" Watermark="不设置默认值" />
                                    <CheckBox Name="ExtraFieldDefaultBooleanInput"
                                              IsVisible="{Binding UsesBooleanEditor}"
                                              IsChecked="{Binding BooleanValue, Mode=TwoWay}"
                                              IsThreeState="True"
                                              Content="{Binding BooleanDisplay}"
                                              VerticalAlignment="Center" />
                                    <CalendarDatePicker Name="ExtraFieldDefaultDateInput"
                                                        IsVisible="{Binding UsesDateEditor}"
                                                        SelectedDate="{Binding DateValue, Mode=TwoWay}"
                                                        Watermark="不设置默认值" />
                                    <Grid Name="ExtraFieldDefaultTimeEditor"
                                          IsVisible="{Binding UsesTimeEditor}"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <TimePicker Name="ExtraFieldDefaultTimeInput"
                                                    SelectedTime="{Binding TimeValue, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock" MinuteIncrement="1" />
                                        <Button Grid.Column="1" Content="清空"
                                                Command="{Binding ClearValueCommand}" />
                                    </Grid>
                                    <Grid Name="ExtraFieldDefaultDateTimeEditor"
                                          IsVisible="{Binding UsesDateTimeEditor}"
                                          ColumnDefinitions="150,Auto,*,Auto" ColumnSpacing="6">
                                        <CalendarDatePicker Name="ExtraFieldDefaultDateTimeDateInput"
                                                            SelectedDate="{Binding DateTimeDateValue, Mode=TwoWay}"
                                                            Watermark="日期" />
                                        <TextBlock Grid.Column="1" Text="·" VerticalAlignment="Center" />
                                        <TimePicker Name="ExtraFieldDefaultDateTimeTimeInput"
                                                    Grid.Column="2"
                                                    SelectedTime="{Binding DateTimeTimeValue, Mode=TwoWay}"
                                                    ClockIdentifier="24HourClock" MinuteIncrement="1" />
                                        <Button Grid.Column="3" Content="清空"
                                                Command="{Binding ClearValueCommand}" />
                                    </Grid>
                                    <Grid Name="ExtraFieldDefaultChoiceEditor"
                                          IsVisible="{Binding UsesChoiceEditor}"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <ComboBox Name="ExtraFieldDefaultChoiceInput"
                                                  ItemsSource="{Binding Options}"
                                                  SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                  PlaceholderText="不设置默认值" />
                                        <Button Grid.Column="1" Content="清空"
                                                Command="{Binding ClearValueCommand}" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ContentControl.DataTemplates>
                    </ContentControl>
                    <TextBlock Text="仅在新建工作项或新增标签时预填，不回填历史数据。"
                               Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
                </StackPanel>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="排序" VerticalAlignment="Center" />
                    <NumericUpDown Name="ExtraFieldSortOrderInput"
                                   Grid.Column="1"
                                   Value="{Binding Field.SortOrder}"
                                   Minimum="0"
                                   FormatString="0" />
                </Grid>

                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource SystemControlErrorTextForeground}"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasValidationMessage}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Classes="DialogFooter">
            <Button Name="CancelExtraFieldButton" Content="取消" Command="{Binding CancelCommand}" />
            <Button Name="SaveExtraFieldButton" Content="确定" Classes="Primary"
                    Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
