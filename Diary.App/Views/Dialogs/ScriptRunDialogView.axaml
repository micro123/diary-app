<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Diary.App.ViewModels.Dialogs"
             xmlns:views="using:Diary.App.Views"
             x:Class="Diary.App.Views.Dialogs.ScriptRunDialogView"
             x:DataType="dialogs:ScriptRunDialogViewModel"
             Width="620" MinWidth="520" MinHeight="360" MaxHeight="720" Padding="12">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
        <StackPanel Spacing="4">
            <TextBlock Text="运行脚本" FontSize="24" FontWeight="Bold" />
            <TextBlock Text="{Binding ScriptName}" Opacity="0.68" />
        </StackPanel>
        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="6">
                <StackPanel IsVisible="{Binding IsV1}" Spacing="4">
                    <TextBlock Text="执行参数" FontWeight="SemiBold" />
                    <TextBox Text="{Binding ArgumentsText, Mode=TwoWay}" AcceptsReturn="True"
                             TextWrapping="NoWrap" Height="170"
                             Watermark="每行一个参数，例如：date=2026-08-25" />
                    <TextBlock Text="使用 key=value 格式；空行和以 # 开头的行会被忽略。"
                               FontSize="12" Opacity="0.62" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasParameters}" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="参数" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ParameterForm.RestoreStatus}" FontSize="12" Opacity="0.62"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Content="清除记忆" IsVisible="{Binding ParameterForm.CanClearMemory}"
                                    Command="{Binding ParameterForm.ClearMemoryCommand}" />
                            <Button Content="恢复默认值"
                                    Command="{Binding ParameterForm.ResetDefaultsCommand}" />
                        </StackPanel>
                    </Grid>
                    <views:ScriptParameterFormView x:Name="ParameterFormView"
                                                   DataContext="{Binding ParameterForm}" />
                </StackPanel>

                <Expander Header="更多执行选项" IsVisible="{Binding ShowExecutionOptions}">
                    <StackPanel Spacing="4" Margin="0 4 0 0">
                        <TextBlock Text="幂等键" />
                        <TextBox Text="{Binding IdempotencyKey, Mode=TwoWay}"
                                 Watermark="可选，例如：daily-summary:2026-08-25" />
                        <TextBlock Text="超时时间（秒）" />
                        <NumericUpDown Value="{Binding TimeoutSeconds, Mode=TwoWay}"
                                       Minimum="1" Maximum="3600" Increment="10" />
                    </StackPanel>
                </Expander>
                <TextBlock Text="{Binding Error}" Foreground="IndianRed" TextWrapping="Wrap"
                           IsVisible="{Binding HasError}" />
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto">
            <CheckBox Content="预览执行" IsVisible="{Binding ShowExecutionOptions}"
                      ToolTip.Tip="宿主会阻止持久写入和真实文件导出。"
                      IsChecked="{Binding Preview, Mode=TwoWay}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="取消" Command="{Binding CancelCommand}" />
                <Button Content="运行" Classes="Primary" Command="{Binding RunCommand}"
                        Click="OnRunClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
