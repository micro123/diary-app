<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="520"
             x:Class="Diary.App.Views.Dialogs.TrackerPluginDiagnosticsView"
             x:DataType="dialogs:TrackerPluginDiagnosticsViewModel"
             MinWidth="620" MinHeight="420" Padding="24">
    <Grid RowDefinitions="Auto,*" RowSpacing="16">
        <StackPanel Spacing="4">
            <TextBlock Text="Tracker 插件状态" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="查看实例运行状态，管理启用、重试和卸载操作。"
                       Opacity="0.65" />
        </StackPanel>
        <Grid Grid.Row="1">
            <TextBlock Text="当前没有已注册的 Tracker 实例。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.6" IsVisible="{Binding IsEmpty}" />
            <ScrollViewer IsVisible="{Binding !IsEmpty}">
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="viewModels:TrackerPluginDiagnosticViewModel">
                        <Border Padding="16" Margin="0 0 0 12"
                                Background="#12000000" CornerRadius="10">
                            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding InstanceSummary}" FontSize="12"
                                                   Opacity="0.55" />
                                    </StackPanel>
                                    <Border Grid.Column="1" MinWidth="72" Padding="10 4"
                                            Background="#18000000" CornerRadius="12">
                                        <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                </Grid>
                                <Border Grid.Row="1" Padding="10 8"
                                        Background="#18000000" CornerRadius="6"
                                        IsVisible="{Binding HasError}">
                                    <TextBlock Text="{Binding Error}" Foreground="IndianRed"
                                               TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Grid.Row="2" Orientation="Horizontal"
                                            HorizontalAlignment="Right" Spacing="8">
                                    <Button Content="重试" Command="{Binding RetryCommand}"
                                            IsVisible="{Binding CanRetry}" Padding="12 6" />
                                    <Button Content="{Binding ToggleText}" Command="{Binding ToggleCommand}"
                                            IsVisible="{Binding CanToggle}" Padding="12 6" />
                                    <Button Content="保留数据卸载" Command="{Binding UninstallCommand}"
                                            IsVisible="{Binding CanUninstall}" Padding="12 6" />
                                    <Button Content="删除数据" Command="{Binding DeleteDataCommand}"
                                            IsVisible="{Binding CanUninstall}" Padding="12 6" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
