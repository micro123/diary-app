<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             xmlns:models="clr-namespace:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.BatchUploadPreviewView"
             x:DataType="dialogs:BatchUploadPreviewViewModel"
             Width="900"
             Height="560"
             Padding="10">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="同步工时" Classes="PageTitle" />
                <TextBlock Grid.Column="1"
                           Text="预览并选择要提交的记录"
                           Classes="PageSubtitle" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="SubtleCard">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="确认后才会执行远程操作；已同步和结果不确定的记录不会自动选中。"
                           Classes="PageSubtitle"
                           VerticalAlignment="Center" />
                <Border Grid.Column="1" Classes="StatusPill StatusInfo">
                    <TextBlock Text="{Binding Summary}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="DetailPane" Padding="6" ClipToBounds="True">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BatchUploadPreviewItem">
                            <Border Classes="SubtleCard" Margin="0,0,0,4">
                                <Grid ColumnDefinitions="Auto,*,Auto,120" ColumnSpacing="10">
                                    <CheckBox IsChecked="{Binding Selected}"
                                              IsEnabled="{Binding CanSelect}"
                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Date}" Classes="PageSubtitle" FontSize="12" />
                                        <TextBlock Text="{Binding TrackerText}"
                                                   Classes="PageSubtitle"
                                                   FontSize="12"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Hours, StringFormat='{}{0:0.##} 小时'}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding StatusText}"
                                               VerticalAlignment="Center"
                                               TextAlignment="Right"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="3" Classes="DialogFooter">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="确认同步" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
