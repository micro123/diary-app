<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:colorPicker="https://irihi.tech/semi"
             xmlns:models="clr-namespace:Diary.App.Models"
             xmlns:dialogs1="clr-namespace:Diary.App.ViewModels.Dialogs"
             mc:Ignorable="d"
             x:Class="Diary.App.Views.Dialogs.TagEditorView"
             x:Name="EditorRoot"
             x:DataType="dialogs1:TagEditorViewModel"
             Width="1080"
             Height="720"
             Margin="8 24 8 8">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Title}" Classes="Header" />
            <TextBlock Text="管理标签、元数据、Tracker 自动化操作和附加字段"
                       Opacity="0.72" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="12">
            <Border Grid.Column="0"
                    Padding="12"
                    Background="{DynamicResource SemiColorFill1}">
                <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                        <TextBlock Text="标签" FontWeight="SemiBold" FontSize="16" />
                        <Button Grid.Column="1"
                                Content="导入"
                                Padding="10 4"
                                Command="{Binding ImportTagsCommand}" />
                        <Button Grid.Column="2"
                                Content="导出"
                                Padding="10 4"
                                Command="{Binding ExportTagsCommand}" />
                    </Grid>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBox Text="{Binding NewTagName}"
                                 Watermark="输入标签名称"
                                 Classes="ClearButton" />
                        <Button Grid.Column="1"
                                Content="添加"
                                Command="{Binding NewTagCommand}" />
                    </Grid>
                    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <CheckBox Content="主标签"
                                  IsChecked="{Binding NewIsPrimary}"
                                  VerticalAlignment="Center"
                                  Theme="{DynamicResource CardCheckBox}" />
                        <ColorPicker Grid.Column="1"
                                     Width="64"
                                     SelectedIndex="1"
                                     PaletteColumnCount="16"
                                     IsAlphaEnabled="False"
                                     IsAlphaVisible="False"
                                     HsvColor="{Binding NewTagColor}">
                            <ColorPicker.Palette>
                                <colorPicker:SemiColorLightPalette />
                            </ColorPicker.Palette>
                        </ColorPicker>
                    </Grid>
                    <ListBox Grid.Row="3"
                             ItemsSource="{Binding AllTags}"
                             SelectedItem="{Binding SelectedTag}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:EditableWorkTag}">
                                <Border Padding="6 5"
                                        Margin="0 0 0 2"
                                        CornerRadius="4">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto"
                                          ColumnSpacing="7">
                                        <Border Width="10"
                                                Height="10"
                                                CornerRadius="5"
                                                Background="{Binding Color, Converter={StaticResource IntColor}}"
                                                BorderBrush="{DynamicResource SemiColorBorder}"
                                                BorderThickness="1"
                                                VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding Name}" />
                                            <TextBlock Text="{Binding ExtraFields.Count, StringFormat='· {0} 个字段'}"
                                                       Opacity="0.62"
                                                       FontSize="12"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2"
                                                   Text="停用"
                                                   FontSize="11"
                                                   Opacity="0.7"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding Disabled}" />
                                        <Button Grid.Column="3"
                                                ToolTip.Tip="删除此标签"
                                                i:Attached.Icon="fa-trash-can"
                                                Command="{Binding #EditorRoot.((dialogs1:TagEditorViewModel)DataContext).DelTagCommand}"
                                                CommandParameter="{Binding}"
                                                Theme="{DynamicResource BorderlessButton}"
                                                Classes="Danger" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="10">
                <Border Grid.Row="0" Padding="12"
                        Background="{DynamicResource SemiColorFill1}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding SelectedTag.Name}"
                                       FontSize="20"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="编辑当前标签的配置"
                                       Opacity="0.65" />
                        </StackPanel>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding SelectedTag.Id, StringFormat='标签 #{0}'}"
                                   VerticalAlignment="Center"
                                   Opacity="0.65" />
                    </Grid>
                </Border>

                <TabControl Grid.Row="1">
                    <TabItem Header="基础信息">
                        <ScrollViewer>
                            <StackPanel Margin="16" Spacing="12">
                                <TextBlock Text="标签名称" />
                                <TextBox Text="{Binding SelectedTag.Name}"
                                         Classes="ClearButton" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="标签颜色" />
                                        <ColorPicker HsvColor="{Binding SelectedTag.Color, Converter={StaticResource Hsv2Int}}"
                                                     SelectedIndex="1"
                                                     PaletteColumnCount="16"
                                                     HorizontalAlignment="Left">
                                            <ColorPicker.Palette>
                                                <colorPicker:SemiColorLightPalette />
                                            </ColorPicker.Palette>
                                        </ColorPicker>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Spacing="10">
                                        <TextBlock Text="标签状态" />
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8">
                                            <TextBlock Text="主标签" VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="1"
                                                          IsChecked="{Binding SelectedTag.Primary}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="禁用"
                                                       VerticalAlignment="Center" />
                                            <ToggleSwitch Grid.Column="3"
                                                          IsChecked="{Binding SelectedTag.Disabled}" />
                                        </Grid>
                                    </StackPanel>
                                </Grid>

                                <Border Padding="10"
                                        Background="{DynamicResource SemiColorFill1}">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="说明"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="标签的基础属性在这里编辑；元数据、自动化操作和附加字段分别位于其他页签。"
                                                   TextWrapping="Wrap"
                                                   Opacity="0.72" />
                                    </StackPanel>
                                </Border>

                                <Button Content="删除当前标签"
                                        HorizontalAlignment="Left"
                                        Classes="Danger"
                                        Command="{Binding DelTagCommand}"
                                        CommandParameter="{Binding SelectedTag}" />
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="元数据">
                        <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="元数据" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="用于保存标签级别的键值信息。"
                                               Opacity="0.65" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="添加元数据"
                                        Command="{Binding SelectedTag.AddMetadataCommand}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding SelectedTag.Metadata}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:EditableWorkTagMetadata}">
                                            <Grid ColumnDefinitions="180,*,Auto"
                                                  ColumnSpacing="8"
                                                  Margin="0 0 0 8">
                                                <TextBox Text="{Binding Key}" Watermark="键" />
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding Value}"
                                                         Watermark="值" />
                                                <Button Grid.Column="2"
                                                        ToolTip.Tip="删除元数据"
                                                        i:Attached.Icon="fa-trash-can"
                                                        Command="{Binding RemoveCommand}"
                                                        Theme="{DynamicResource BorderlessButton}"
                                                        Classes="Danger" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="自动化操作">
                        <ScrollViewer>
                            <StackPanel Margin="16" Spacing="10">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="Tracker 自动化操作"
                                               FontSize="16"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="由已启用的 Tracker 提供标签规则配置入口。修改会在保存标签配置时统一提交。"
                                               TextWrapping="Wrap"
                                               Opacity="0.65" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding RuleContributions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10"
                                                    Margin="0 0 0 8"
                                                    Background="{DynamicResource SemiColorFill1}">
                                                <ContentControl Content="{Binding View}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="附加字段">
                        <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3">
                                    <TextBlock Text="附加字段" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="字段值为可选项；FieldKey 和字段类型创建后不能修改。"
                                               TextWrapping="Wrap"
                                               Opacity="0.65" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Content="新增字段"
                                        Command="{Binding AddExtraFieldCommand}" />
                            </Grid>
                            <ScrollViewer Grid.Row="1">
                                <ItemsControl ItemsSource="{Binding SelectedTag.ExtraFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:EditableTagExtraField}">
                                            <Border Padding="10"
                                                    Margin="0 0 0 8"
                                                    Background="{DynamicResource SemiColorFill1}">
                                                <Grid RowDefinitions="Auto,Auto,Auto"
                                                      ColumnDefinitions="*,Auto,Auto"
                                                      RowSpacing="5"
                                                      ColumnSpacing="8">
                                                    <StackPanel Spacing="2">
                                                        <TextBlock Text="{Binding Label}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding FieldKey}"
                                                                   FontFamily="Consolas"
                                                                   Opacity="0.72" />
                                                    </StackPanel>
                                                    <ToggleSwitch Grid.Column="1"
                                                                  IsChecked="{Binding Enabled}"
                                                                  OnContent="启用"
                                                                  OffContent="停用"
                                                                  VerticalAlignment="Center" />
                                                    <Button Grid.Column="2"
                                                            Content="编辑"
                                                            Command="{Binding #EditorRoot.((dialogs1:TagEditorViewModel)DataContext).EditExtraFieldCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <TextBlock Grid.Row="1"
                                                               Text="{Binding Type, StringFormat='类型：{0}'}"
                                                               Opacity="0.72" />
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Grid.ColumnSpan="2"
                                                               Text="{Binding SortOrder, StringFormat='排序：{0}'}"
                                                               Opacity="0.72" />
                                                    <TextBlock Grid.Row="2"
                                                               Grid.ColumnSpan="3"
                                                               Text="{Binding Description}"
                                                               TextWrapping="Wrap"
                                                               Opacity="0.65" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Content="保存更改" Classes="Primary" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
