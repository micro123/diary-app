<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="using:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.TagShareExportDialogView"
             x:DataType="dialogs:TagShareExportDialogViewModel"
             Width="720"
             Height="440"
             MaxHeight="520"
             Padding="10"
             HorizontalContentAlignment="Stretch"
             VerticalContentAlignment="Stretch">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="导出标签共享包" Classes="PageTitle" />
                <TextBlock Grid.Column="1"
                           Text="选择要包含的标签"
                           Classes="PageSubtitle" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="SubtleCard">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Content="全选" Command="{Binding SelectAllCommand}" />
                <Button Grid.Column="1" Content="清空" Command="{Binding ClearSelectionCommand}" />
                <TextBlock Grid.Column="2"
                           Text="对应的元数据、附加字段和 Tracker 规则会一起导出。"
                           Classes="PageSubtitle"
                           VerticalAlignment="Center" />
                <Border Grid.Column="3" Classes="StatusPill StatusInfo">
                    <TextBlock Text="{Binding SelectedCount, StringFormat='已选择 {0} 个'}" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="2" Classes="DetailPane" Padding="6" ClipToBounds="True">
            <ListBox ItemsSource="{Binding Items}"
                     SelectionMode="Single"
                     MinHeight="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="dialogs:TagShareExportItemViewModel">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="2,1">
                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Spacing="1">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Details}"
                                           Classes="PageSubtitle"
                                           FontSize="12" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Classes="DialogFooter">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Content="选择保存位置"
                    Classes="Primary"
                    Command="{Binding ExportCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
