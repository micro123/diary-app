<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             x:Class="Diary.App.Views.Dialogs.ScriptConfirmDialogView"
             x:DataType="dialogs:ScriptConfirmDialogViewModel"
             Width="520"
             MinWidth="460"
             MaxWidth="620"
             MaxHeight="560"
             Padding="10">
    <UserControl.Styles>
        <Style Selector="Border.ScriptConfirmIcon">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Background" Value="#2563A8" />
        </Style>
        <Style Selector="Border.ScriptConfirmIcon i|Icon">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="24" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.ScriptConfirmButton">
            <Setter Property="MinWidth" Value="92" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border Classes="ScriptConfirmIcon">
                    <i:Icon Value="mdi-message-question-outline" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Name="ScriptConfirmDialogTitle"
                               Text="{Binding DialogTitle}"
                               Classes="PageTitle"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GuidanceText}"
                               Classes="PageSubtitle"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Classes="DetailPane"
                IsVisible="{Binding HasMessage}"
                ClipToBounds="True">
            <Grid RowDefinitions="Auto,Auto">
                <Border Classes="DetailHeader">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <i:Icon Value="mdi-file-document-outline" FontSize="16" />
                        <TextBlock Text="脚本消息" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <ScrollViewer Grid.Row="1"
                              MinHeight="44"
                              MaxHeight="260"
                              Padding="12"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <SelectableTextBlock Name="ScriptConfirmDialogMessage"
                                         Text="{Binding Message}"
                                         TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Classes="DialogFooter">
            <Button Name="ScriptConfirmCancelButton"
                    Classes="ScriptConfirmButton"
                    Content="取消"
                    Command="{Binding CancelCommand}" />
            <Button Name="ScriptConfirmAcceptButton"
                    Classes="Primary ScriptConfirmButton"
                    Content="确认"
                    Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
