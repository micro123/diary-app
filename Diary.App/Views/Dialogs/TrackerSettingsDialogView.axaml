<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.TrackerSettingsDialogView"
             x:DataType="dialogs:TrackerSettingsDialogViewModel"
             Width="950" Height="650" Padding="12">
    <Grid RowDefinitions="*,Auto" RowSpacing="12">
        <TabControl>
            <TabItem Header="Tracker 配置">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="插件状态">
                <ContentControl Content="{Binding Diagnostics}" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="保存" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
