<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.TrackerSettingsDialogView"
             x:DataType="dialogs:TrackerSettingsDialogViewModel"
             Width="950" Height="650" Padding="10">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="Tracker 设置" Classes="PageTitle" />
                <TextBlock Grid.Column="1" Text="实例配置与插件状态" Classes="PageSubtitle"
                           ToolTip.Tip="配置 Jira、Redmine 等外部服务实例，并查看插件运行和本地数据状态。" />
            </Grid>
        </Border>
        <TabControl Grid.Row="1" Theme="{DynamicResource LineTabControl}">
            <TabItem Header="Tracker 配置">
                <TabControl ItemsSource="{Binding ProviderPages}" Margin="0,4,0,0">
                    <TabControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:TrackerSettingsPageItem">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.ContentTemplate>
                        <DataTemplate x:DataType="dialogs:TrackerSettingsPageItem">
                            <ContentControl Content="{Binding Page}" />
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </TabItem>
            <TabItem Header="插件状态">
                <ContentControl Content="{Binding Diagnostics}" Margin="0,4,0,0" />
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Classes="DialogFooter">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="保存" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
