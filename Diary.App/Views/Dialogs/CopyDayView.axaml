<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.CopyDayView"
             x:DataType="dialogs:CopyDayViewModel"
             Width="500"
             Padding="10">
    <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid Classes="PageHeading" ColumnDefinitions="Auto,*">
                <TextBlock Text="复制整天记录" Classes="PageTitle" />
                <TextBlock Grid.Column="1"
                           Text="从其他日期复制事项"
                           Classes="PageSubtitle" />
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="DetailPane" Padding="12">
            <StackPanel Spacing="10">
                <TextBlock Text="记录会复制到当前日期；远程 Tracker 绑定不会一并复制。"
                           Classes="SectionDescription" />
                <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                    <TextBlock Text="源日期" Classes="FieldLabel" />
                    <CalendarDatePicker Grid.Column="1"
                                        SelectedDate="{Binding SourceDate}"
                                        IsTodayHighlighted="True"
                                        HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="1" Text="目标日期：" Classes="FieldLabel" />
                    <Border Grid.Row="1" Grid.Column="1" Classes="SubtleCard" Padding="10,7">
                        <TextBlock Text="{Binding TargetDateText}" FontWeight="SemiBold" />
                    </Border>
                </Grid>
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="{DynamicResource SystemControlErrorTextForeground}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Classes="DialogFooter">
            <Button Content="取消" Command="{Binding CancelCommand}" />
            <Button Classes="Primary" Content="继续" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
