<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             x:Class="Diary.App.Views.Dialogs.ExportTemplateManagerView"
             x:DataType="dialogs:ExportTemplateManagerViewModel"
             Width="900" Height="620" Padding="20">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Text="数据模板" Classes="PageTitle" />
                <TextBlock Text="导入模板文件后，由对应插件校验模板结构并声明所需导出数据。"
                           Classes="PageSubtitle" />
            </StackPanel>
            <Button Grid.Column="1" Content="导入模板" Command="{Binding ImportCommand}"
                    Classes="Primary" VerticalAlignment="Center" />
        </Grid>
        <Grid Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                        IsVisible="{Binding IsEmpty}">
                <TextBlock Text="尚未导入数据模板。" Classes="EmptyStateTitle" />
                <TextBlock Text="导入模板后可在脚本导出时复用格式和数据绑定。"
                           Classes="EmptyStateDescription" />
            </StackPanel>
            <ScrollViewer IsVisible="{Binding !IsEmpty}">
                <ItemsControl ItemsSource="{Binding Templates}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="dialogs:ExportTemplateItemViewModel">
                            <Border Padding="14" Margin="0 0 0 10"
                                    Background="#12000000" CornerRadius="8">
                                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="16"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding TemplateId}" FontFamily="monospace"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Extension}"
                                                   VerticalAlignment="Center" Opacity="0.7" />
                                    </Grid>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding PluginId, StringFormat=插件：{0}}"
                                               Opacity="0.65" />
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding BindingSummary, StringFormat=数据：{0}}"
                                               TextWrapping="Wrap" Opacity="0.8" />
                                    <StackPanel Grid.Row="3" Orientation="Horizontal"
                                                HorizontalAlignment="Right" Spacing="8">
                                        <Button Content="重新校验" Command="{Binding $parent[ItemsControl].DataContext.RevalidateCommand}"
                                                CommandParameter="{Binding}" Padding="12 6" />
                                        <Button Content="启用/禁用" Command="{Binding $parent[ItemsControl].DataContext.ToggleCommand}"
                                                CommandParameter="{Binding}" Padding="12 6" />
                                        <Button Content="归档" Command="{Binding $parent[ItemsControl].DataContext.ArchiveCommand}"
                                                CommandParameter="{Binding}" Padding="12 6" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" Opacity="0.8" />
            <Button Grid.Column="1" Content="关闭" Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</UserControl>
