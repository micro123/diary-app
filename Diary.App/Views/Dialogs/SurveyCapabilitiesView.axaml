<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dialogs="clr-namespace:Diary.App.ViewModels.Dialogs"
             xmlns:viewModels="clr-namespace:Diary.App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="720" d:DesignHeight="520"
             x:Class="Diary.App.Views.Dialogs.SurveyCapabilitiesView"
             x:DataType="dialogs:SurveyCapabilitiesViewModel"
             Width="720" MinHeight="420" MaxHeight="620" Padding="14">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="新版节点能力" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="这些信息主要用于确认节点能否执行扩展查询，不影响兼容查询。"
                       Opacity="0.68" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Padding="8,6" CornerRadius="8"
                Background="{DynamicResource SemiColorFill1}">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
        </Border>

        <Grid Grid.Row="2">
            <TextBlock Text="当前没有可显示的新版节点。请关闭窗口并重新执行节点探测。"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Opacity="0.62" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}" />

            <ScrollViewer IsVisible="{Binding !IsEmpty}"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Capabilities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:SurveyCapabilityResult">
                            <Border Margin="0,0,0,6" Padding="9" CornerRadius="9"
                                    BorderThickness="1" BorderBrush="{DynamicResource SemiColorBorder}"
                                    Background="{DynamicResource SemiColorFill2}">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto"
                                      RowSpacing="6" ColumnSpacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding NodeName}" FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="新版协议节点" Opacity="0.58" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Padding="10,4" CornerRadius="12"
                                            Background="{DynamicResource SemiColorFill1}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DetailsText}" />
                                    </Border>

                                    <Grid Grid.Row="1" Grid.ColumnSpan="2"
                                          ColumnDefinitions="110,*" ColumnSpacing="10">
                                        <TextBlock Text="查询能力" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding KindsText}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Grid.Row="2" Grid.ColumnSpan="2"
                                          ColumnDefinitions="110,*" ColumnSpacing="10">
                                        <TextBlock Text="分组能力" FontWeight="SemiBold" />
                                        <TextBlock Grid.Column="1" Text="{Binding GroupDimensionsText}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Button Grid.Row="3" Content="关闭" Command="{Binding DismissCommand}"
                HorizontalAlignment="Right" MinWidth="88" />
    </Grid>
</UserControl>
