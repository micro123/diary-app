<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>Assets\Icons\diary-app.ico</ApplicationIcon>
        <GenerateAssemblyDescriptionAttribute>false</GenerateAssemblyDescriptionAttribute>
        <GenerateAssemblyFileVersionAttribute>false</GenerateAssemblyFileVersionAttribute>
        <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
        <GenerateAssemblyVersionAttribute>false</GenerateAssemblyVersionAttribute>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <CETCompat>false</CETCompat>
        <ImplicitUsings>true</ImplicitUsings>
    </PropertyGroup>

    <ItemGroup>
        <TrackerPluginProject Include="..\Diary.RedMine\Diary.RedMine.csproj" />
        <TrackerPluginProject Include="..\Diary.RedMine.UI\Diary.RedMine.UI.csproj" />
        <TrackerPluginProject Include="..\Diary.RedMine.SQLite\Diary.RedMine.SQLite.csproj" />
        <TrackerPluginProject Include="..\Diary.RedMine.PostgreSQL\Diary.RedMine.PostgreSQL.csproj" />
        <TrackerPluginProject Include="..\Diary.Jira\Diary.Jira.csproj" />
        <TrackerPluginProject Include="..\Diary.Jira.UI\Diary.Jira.UI.csproj" />
        <TrackerPluginProject Include="..\Diary.Jira.SQLite\Diary.Jira.SQLite.csproj" />
        <TrackerPluginProject Include="..\Diary.Jira.PostgreSQL\Diary.Jira.PostgreSQL.csproj" />
    </ItemGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" Exclude="Assets\Fonts\**" />
        <Content Include="Assets\Fonts\NotoSansMonoCJKsc-Regular.otf"
                 TargetPath="Fonts\NotoSansMonoCJKsc-Regular.otf"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="Assets\Fonts\NotoSansMonoCJK-OFL.txt"
                 TargetPath="Fonts\NotoSansMonoCJK-OFL.txt"
                 CopyToOutputDirectory="PreserveNewest"
                 CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\SurveyUserGuide.md" Link="Docs\SurveyUserGuide.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\ExportTemplateGuide.md" Link="Docs\ExportTemplateGuide.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\ScriptApi\**\*" Link="Docs\ScriptApi\%(RecursiveDir)%(Filename)%(Extension)"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\AiScriptContextDesign.md" Link="Docs\AiScriptContextDesign.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\AiScriptContextGuide.md" Link="Docs\AiScriptContextGuide.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
        <Content Include="..\Docs\AiAgentUserGuide.md" Link="Docs\AiAgentUserGuide.md"
                 CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Diary.AiContext\Diary.AiContext.csproj" />
        <PackageReference Include="Avalonia.Desktop" Version="11.3.18" />
        <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" Version="0.2.661903" />
        <PackageReference Include="System.Diagnostics.EventLog" Version="10.0.10" />
        <PackageReference Include="SkiaSharp" Version="2.88.9" />
        <PackageReference Include="Semi.Avalonia.AvaloniaEdit" Version="11.2.0.2" />
        <PackageReference Include="AvaloniaEdit.TextMate" Version="11.2.0" />
        <PackageReference Include="Svg.Controls.Skia.Avalonia" Version="11.3.9.5" />
        <!--Condition below is needed to remove Avalonia.Diagnostics package from build output in Release configuration.-->
        <PackageReference Include="Avalonia.Diagnostics" Version="11.3.18">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Chrome.DevTools.Avalonia.v11" Version="0.1.0-preview.30"
                          Condition="'$(Configuration)' == 'Debug'" />
        <!-- CDP preview.30 targets Roslyn 4.12; align its open ranges with Diary.Script.CSharp 5.6 in Debug. -->
        <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.Common" Version="5.6.0" Condition="'$(Configuration)' == 'Debug'" />
        <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" Condition="'$(Configuration)' == 'Debug'" />
    </ItemGroup>

    <ItemGroup>
        <!-- nng.NET ships reference copies for multiple TFMs under runtimes/any; they are package payload, not app assemblies. -->
        <PublishReadyToRunExclude Include="nng.NET.dll" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Diary.Core\Diary.Core.csproj" />
        <ProjectReference Include="..\Diary.Database\Diary.Database.csproj" />
        <ProjectReference Include="..\Diary.Db.PostgreSQL\Diary.Db.PostgreSQL.csproj" />
        <ProjectReference Include="..\Diary.GUIBase\Diary.GUIBase.csproj" />
        <ProjectReference Include="..\Diary.Agent.UI\Diary.Agent.UI.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Diary.Mcp.Remote\Diary.Mcp.Remote.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Diary.ModuleBase\Diary.ModuleBase.csproj" />
        <ProjectReference Include="..\Diary.ModuleUI\Diary.ModuleUI.csproj" />
        <ProjectReference Include="..\Diary.MigrationTool\Diary.MigrationTool.csproj" />
        <ProjectReference Include="..\Diary.PluginBase\Diary.PluginBase.csproj" />
        <ProjectReference Include="..\Diary.PluginUI\Diary.PluginUI.csproj" />
        <ProjectReference Include="..\Diary.Db.SQLite\Diary.Db.SQLite.csproj" />
        <ProjectReference Include="..\Diary.Export.Csv\Diary.Export.Csv.csproj" />
        <ProjectReference Include="..\Diary.Export.Docx\Diary.Export.Docx.csproj" />
        <ProjectReference Include="..\Diary.Export.Xlsx\Diary.Export.Xlsx.csproj" />
        <ProjectReference Include="..\Diary.Export.Mustache\Diary.Export.Mustache.csproj" />
        <ProjectReference Include="..\Diary.Script.CSharp\Diary.Script.CSharp.csproj" />
        <ProjectReference Include="..\Diary.Script.Lua\Diary.Script.Lua.csproj" />
        <ProjectReference Include="..\Diary.Script.Python\Diary.Script.Python.csproj" />
        <ProjectReference Include="..\Diary.Script.Runtime\Diary.Script.Runtime.csproj" />
        <ProjectReference Include="..\Diary.Script.Worker\Diary.Script.Worker.csproj" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\Diary.ScriptHost\Diary.ScriptHost.csproj" />
        <ProjectReference Include="..\Diary.ScriptBase\Diary.ScriptBase.csproj" />
        <ProjectReference Include="..\Diary.Survey\Diary.Survey.csproj" />
        <ProjectReference Include="..\Diary.Update\Diary.Update.csproj" />
        <ProjectReference Include="..\Diary.Utils\Diary.Utils.csproj" />
    </ItemGroup>

    <Target Name="BuildAndCopyTrackerPlugins" AfterTargets="Build">
        <MSBuild Projects="@(TrackerPluginProject)"
                 Targets="Restore"
                 BuildInParallel="false"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)"
                 Condition="'$(RuntimeIdentifier)' != ''" />
        <MSBuild Projects="@(TrackerPluginProject)"
                 Targets="Build"
                 BuildInParallel="true"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)" />
        <MSBuild Projects="@(TrackerPluginProject)"
                 Targets="GetTargetPath"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained)">
            <Output TaskParameter="TargetOutputs" ItemName="TrackerPluginAssembly" />
        </MSBuild>
        <Copy SourceFiles="@(TrackerPluginAssembly)" DestinationFolder="$(OutputPath)" />
    </Target>

    <Target Name="BuildAndCopyAiAgentModule" AfterTargets="Build">
        <MSBuild Projects="..\Diary.Agent.UI\Diary.Agent.UI.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
        <PropertyGroup>
            <AiAgentBuildDirectory>$(MSBuildProjectDirectory)\..\Diary.Agent.UI\bin\$(Configuration)\net10.0\</AiAgentBuildDirectory>
            <AiAgentCoreBuildDirectory>$(MSBuildProjectDirectory)\..\Diary.Agent\bin\$(Configuration)\net10.0\</AiAgentCoreBuildDirectory>
            <AiAgentModuleDirectory>$(OutputPath)Modules\diary.ai-agent\</AiAgentModuleDirectory>
        </PropertyGroup>
        <ItemGroup>
            <AiAgentModuleOutput Include="$(AiAgentBuildDirectory)Diary.Agent.UI.dll" />
            <AiAgentModuleOutput Include="$(AiAgentBuildDirectory)Diary.Agent.UI.deps.json" />
            <AiAgentModuleOutput Include="$(AiAgentBuildDirectory)Diary.Agent.dll" />
            <AiAgentModuleOutput Include="$(AiAgentCoreBuildDirectory)AngleSharp.dll" />
            <AiAgentModuleOutput Include="$(MSBuildProjectDirectory)\..\Diary.Agent.UI\module.json" />
        </ItemGroup>
        <MakeDir Directories="$(AiAgentModuleDirectory)" />
        <Copy SourceFiles="@(AiAgentModuleOutput)"
              DestinationFolder="$(AiAgentModuleDirectory)"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="BuildAndCopyRemoteMcpModule" AfterTargets="Build">
        <MSBuild Projects="..\Diary.Mcp.Remote\Diary.Mcp.Remote.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)"
                 RemoveProperties="RuntimeIdentifier;SelfContained;PublishSingleFile" />
        <PropertyGroup>
            <RemoteMcpBuildDirectory>$(MSBuildProjectDirectory)\..\Diary.Mcp.Remote\bin\$(Configuration)\net10.0\</RemoteMcpBuildDirectory>
            <RemoteMcpModuleDirectory>$(OutputPath)Modules\diary.mcp.remote\</RemoteMcpModuleDirectory>
        </PropertyGroup>
        <ItemGroup>
            <RemoteMcpModuleOutput Include="$(RemoteMcpBuildDirectory)Diary.Mcp.Remote.dll" />
            <RemoteMcpModuleOutput Include="$(RemoteMcpBuildDirectory)Diary.Mcp.Remote.deps.json" />
            <RemoteMcpModuleOutput Include="$(MSBuildProjectDirectory)\..\Diary.Mcp.Remote\module.json" />
        </ItemGroup>
        <MakeDir Directories="$(RemoteMcpModuleDirectory)" />
        <Copy SourceFiles="@(RemoteMcpModuleOutput)"
              DestinationFolder="$(RemoteMcpModuleDirectory)"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="BuildAndCopyScriptWorker" AfterTargets="Build">
        <MSBuild Projects="..\Diary.Script.Worker\Diary.Script.Worker.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier)" />
        <ItemGroup>
            <!-- RID 发布时 Worker 输出在 net10.0/$(RuntimeIdentifier)/ 子目录，RecursiveDir 需相对于该目录，
                 否则文件会嵌套进 OutputPath 的 RID 子目录，导致发布复制找不到 Worker 文件。 -->
            <ScriptWorkerOutput Include="..\Diary.Script.Worker\bin\$(Configuration)\net10.0\$(RuntimeIdentifier)\**\*"
                                Condition="'$(RuntimeIdentifier)' != ''" />
            <ScriptWorkerOutput Include="..\Diary.Script.Worker\bin\$(Configuration)\net10.0\**\*"
                                Condition="'$(RuntimeIdentifier)' == ''" />
        </ItemGroup>
        <Copy SourceFiles="@(ScriptWorkerOutput)"
              DestinationFiles="@(ScriptWorkerOutput->'$(OutputPath)%(RecursiveDir)%(Filename)%(Extension)')"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="BuildAndCopyAiMcp" AfterTargets="Build" Condition="'$(RuntimeIdentifier)' == ''">
        <MSBuild Projects="..\Diary.Mcp\Diary.Mcp.csproj"
                 Targets="Build"
                 Properties="Configuration=$(Configuration)" />
        <ItemGroup>
            <AiMcpBuildOutput Include="..\Diary.Mcp\bin\$(Configuration)\net10.0\*" />
        </ItemGroup>
        <Copy SourceFiles="@(AiMcpBuildOutput)"
              DestinationFolder="$(OutputPath)"
              SkipUnchangedFiles="true" />
    </Target>

    <Target Name="PublishAiMcp" AfterTargets="Publish"
            Condition="'$(RuntimeIdentifier)' != ''">
        <PropertyGroup>
            <AiMcpPublishDirectory>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)DiaryMcpPublish\</AiMcpPublishDirectory>
            <AiMcpMergePython Condition="$([MSBuild]::IsOSPlatform('Windows'))">python</AiMcpMergePython>
            <AiMcpMergePython Condition="!$([MSBuild]::IsOSPlatform('Windows'))">python3</AiMcpMergePython>
            <AiMcpCaseInsensitiveArgument Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))"> --case-insensitive</AiMcpCaseInsensitiveArgument>
            <AiMcpMergeSourceDirectory>$(AiMcpPublishDirectory).</AiMcpMergeSourceDirectory>
            <AiMcpMergeTargetDirectory>$(PublishDir).</AiMcpMergeTargetDirectory>
        </PropertyGroup>
        <RemoveDir Directories="$(AiMcpPublishDirectory)" />
        <MSBuild Projects="..\Diary.Mcp\Diary.Mcp.csproj"
                 Targets="Restore"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true" />
        <MSBuild Projects="..\Diary.Mcp\Diary.Mcp.csproj"
                 Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=true;PublishSingleFile=false;DebugType=None;DebugSymbols=false;PublishDir=$(AiMcpPublishDirectory)" />
        <Exec Command="$(AiMcpMergePython) &quot;$(MSBuildProjectDirectory)/../Tools/merge-publish-directory.py&quot; --source &quot;$(AiMcpMergeSourceDirectory)&quot; --target &quot;$(AiMcpMergeTargetDirectory)&quot;$(AiMcpCaseInsensitiveArgument)" />
    </Target>
    
    <Target Name="IncludeRuntimeExtensionsInPublish" AfterTargets="ComputeFilesToPublish">
        <ItemGroup>
            <RuntimeExtensionPublishOutput Include="$(OutputPath)Diary.Script.Worker.dll" />
            <RuntimeExtensionPublishOutput Include="$(OutputPath)Diary.RedMine.UI.dll" />
            <RuntimeExtensionPublishOutput Include="$(OutputPath)Diary.Jira*.dll" />
            <ResolvedFileToPublish Include="@(RuntimeExtensionPublishOutput)">
                <RelativePath>%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <AiAgentModulePublishOutput Include="$(OutputPath)Modules\diary.ai-agent\**\*" />
            <ResolvedFileToPublish Include="@(AiAgentModulePublishOutput)">
                <RelativePath>Modules\diary.ai-agent\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
            <RemoteMcpModulePublishOutput Include="$(OutputPath)Modules\diary.mcp.remote\**\*" />
            <ResolvedFileToPublish Include="@(RemoteMcpModulePublishOutput)">
                <RelativePath>Modules\diary.mcp.remote\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
                <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
            </ResolvedFileToPublish>
        </ItemGroup>
    </Target>

    <Target Name="GenVersionInfo" BeforeTargets="BeforeBuild">
      <Exec Command="pwsh.exe -NoProfile -File &quot;$(MSBuildThisFileDirectory)Scripts\gen_version.ps1&quot; $(MSBuildProjectName) &quot;$(IntermediateOutputPath)Generated&quot; VersionInfo.cs"
            Condition="$([MSBuild]::IsOSPlatform('Windows'))"
            UseUtf8Encoding="Always" />
      <Exec Command="/bin/bash &quot;$(MSBuildThisFileDirectory)Scripts/gen_version.sh&quot; $(MSBuildProjectName) &quot;$(IntermediateOutputPath)Generated&quot; VersionInfo.cs"
            Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
        <ItemGroup>
            <Compile Include="$(IntermediateOutputPath)\Generated\VersionInfo.cs" />
        </ItemGroup>
    </Target>
</Project>
