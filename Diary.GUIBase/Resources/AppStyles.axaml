<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia"
        xmlns:u="https://irihi.tech/ursa">
    <!-- Add Styles Here -->
    <Style Selector="DataGrid">
        <Style Selector="^ DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorTertiaryActive}"/>
        </Style>
        <Style Selector="^ DataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>
    </Style>
    <Style Selector="TreeDataGrid">
        <Style Selector="^ TreeDataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
            <Setter Property="Foreground" Value="{DynamicResource SemiColorTertiaryActive}"/>
            <Style Selector="^:pointerover /template/ Border#DataGridBorder">
                <Setter Property="Background" Value="{DynamicResource SemiColorFill2}"/>
            </Style>
        </Style>
        <Style Selector="^ TreeDataGridRow:nth-child(2n)">
            <Setter Property="Background" Value="{DynamicResource SemiColorFill0}" />
        </Style>    
    </Style>
    <Style Selector="CalendarDatePicker">
        <!-- 从周一开始显示 -->
        <Setter Property="FirstDayOfWeek" Value="Monday" />
        <Setter Property="Width" Value="160" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
        <Style Selector="^:disabled /template/ TextBox#PART_TextBox:disabled">
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
        </Style>
        <Setter Property="SelectedDateFormat" Value="Custom" />
        <Setter Property="CustomDateFormatString" Value="yyyy-MM-dd" />
    </Style>
    <Style Selector="u|WindowNotificationManager">
        <Setter Property="Position" Value="BottomRight" />
    </Style>
    <Style Selector="Grid.SettingLineBox">
        <Setter Property="MinWidth" Value="450" />
        <Setter Property="ColumnSpacing" Value="4" />
        <Setter Property="Margin" Value="4 1" />
    </Style>
    <Style Selector="TextBlock.SettingLineCaption">
        <Setter Property="Width" Value="150" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="{ReflectionBinding Title, StringFormat='{}{0}:'}" />
    </Style>
    <Style Selector="Expander.Settings:down">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Style Selector="^ TextBlock.SectionHeader">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="^:expanded TextBlock.SectionHeader">
            <Setter Property="Foreground" Value="{DynamicResource ButtonDefaultPrimaryForeground}" />
        </Style>
    </Style>
    <Style Selector="TextBox.SLV, ToggleSwitch.SLV, ComboBox.SLV, Button.SLV, u|PathPicker.SLV, u|NumericUpDown.SLV">
        <Setter Property="Width" Value="400" />
    </Style>
    <Style Selector="TextBox.SLV, ComboBox.SLV, Button.SLV, u|NumericUpDown.SLV">
        <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style Selector="Expander.Settings:down /template/ Border#ExpanderContent">
        <Setter Property="BorderThickness" Value="0 0 0 1" />
        <Setter Property="Padding" Value="6,4" />
        <Style Selector="^:expanded /template/ Border#ExpanderContent">
            <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        </Style>
    </Style>
    <Style Selector="Expander.Settings:down /template/ ToggleButton#ExpanderHeader">
        <Setter Property="FontSize" Value="{StaticResource SemiFontSizeHeader3}"/>
        <Setter Property="Padding" Value="8,4" />
    </Style>
    <Style Selector="ItemsControl.Settings">
        <Setter Property="Template">
            <ControlTemplate>
                <ScrollViewer Padding="{TemplateBinding Padding}">
                    <ItemsPresenter />
                </ScrollViewer>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBlock.Header">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.PageTitle">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.PageSubtitle">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.EmptyStateTitle">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.EmptyStateDescription">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="StackPanel.DialogFooter">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="6" />
    </Style>
    <Style Selector="TextBlock.PaginationText">
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="CheckBox.ToolbarCheckBox">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Expander.WorkspaceSection">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Style Selector="^:down /template/ ToggleButton#ExpanderHeader">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="^:down /template/ Border#ExpanderContent">
            <Setter Property="Padding" Value="8,6" />
        </Style>
    </Style>
    <Style Selector="Border.WorkspaceToolbar">
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
    </Style>
    <Style Selector="Border.PageHeader">
        <Setter Property="Padding" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.SectionCard">
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.SubtleCard">
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
    </Style>
    <Style Selector="Border.MasterPane">
        <Setter Property="Padding" Value="6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.DetailPane">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.DetailHeader">
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style Selector="Border.StatusPill">
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource SemiColorFill2}" />
    </Style>
    <Style Selector="TextBlock.SectionTitle">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.SectionDescription">
        <Setter Property="Opacity" Value="0.68" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.FieldLabel">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.PageActions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="6" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="StackPanel.CompactActions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.IconAction">
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="Padding" Value="6" />
    </Style>
    <Style Selector="TextBlock.GridText">
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
    </Style>
    <Style Selector="ItemsControl.Reorderable ContentPresenter">
        <Setter Property="(Interaction.Behaviors)">
            <BehaviorCollectionTemplate>
                <BehaviorCollection>
                    <ListReorderDragBehavior IsEnabled="True" Orientation="Vertical"
                                             PlaceholderTemplate="{StaticResource SimplePlaceHolder}"/>
                </BehaviorCollection>
            </BehaviorCollectionTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.HelperIcon">
        <Setter Property="(ToolTip.ShowDelay)" Value="0" />
        <Setter Property="Padding" Value="12 0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Child">
            <Template>
                <i:Icon Value="mdi-help-circle-outline" FontSize="24"
                        Foreground="{DynamicResource ButtonDefaultPrimaryForeground}"/>
            </Template>
        </Setter>
    </Style>
    <Style Selector="Button.ActionButton">
        <Setter Property="(ToolTip.Tip)" Value="{Binding $self.HotKey, StringFormat='快捷键：{0}'}" />
        <Setter Property="(ToolTip.ShowDelay)" Value="150" />
    </Style>
    <Style Selector="ToolTip">
        <Setter Property="ShowOnDisabled" Value="True"/>
    </Style>
</Styles>
