<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Diary.RedMine.UI.ViewModels"
             x:Class="Diary.RedMine.UI.Views.RedMineTagRuleEditorView"
             x:DataType="viewModels:RedMineTagRuleEditorViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="添加规则" HorizontalAlignment="Left" Command="{Binding AddTagRuleCommand}" />
            <TextBlock Text="需要先创建至少一个启用的工作标签。"
                       VerticalAlignment="Center" Opacity="0.65"
                       IsVisible="{Binding ShowNoTagsHint}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding TagRules}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="viewModels:RedMineTagRuleViewModel">
                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                            HorizontalAlignment="Stretch"
                            Background="{DynamicResource SemiColorFill2}">
                        <Grid ColumnDefinitions="Auto,Auto,*,2*,Auto" ColumnSpacing="12">
                            <CheckBox Content="启用"
                                      IsChecked="{Binding Enabled}"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1"
                                        Spacing="3"
                                        IsVisible="{Binding ShowTagSelector}">
                                <TextBlock Text="标签" Opacity="0.65" />
                                <ComboBox MinWidth="150"
                                          ItemsSource="{Binding Tags}"
                                          SelectedItem="{Binding SelectedTag}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Spacing="3">
                                <TextBlock Text="活动" Opacity="0.65" />
                                <ComboBox MinWidth="150"
                                          ItemsSource="{Binding Activities}"
                                          SelectedItem="{Binding SelectedActivity}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="3" Spacing="3">
                                <TextBlock Text="问题" Opacity="0.65" />
                                <ComboBox MinWidth="220"
                                          ItemsSource="{Binding Issues}"
                                          SelectedItem="{Binding SelectedIssue}">
                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <Button Grid.Column="4"
                                    Content="删除"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding $parent[UserControl].((viewModels:RedMineTagRuleEditorViewModel)DataContext).RemoveTagRuleCommand}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
