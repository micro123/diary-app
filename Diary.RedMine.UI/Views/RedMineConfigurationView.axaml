<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Diary.RedMine.UI.ViewModels"
             x:Class="Diary.RedMine.UI.Views.RedMineConfigurationView"
             x:DataType="viewModels:RedMineConfigurationViewModel"
             Padding="6">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Grid Classes="SectionHeading" ColumnDefinitions="Auto,*">
                    <TextBlock Text="Redmine Tracker 实例" Classes="SectionTitle" />
                    <TextBlock Grid.Column="1" Text="连接、实例与标签规则" Classes="SectionDescription" />
                </Grid>
                <Button Grid.Column="1" Content="添加实例" Classes="Primary"
                        Command="{Binding AddInstanceCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>
        <Grid Grid.Row="1" ColumnDefinitions="260,*" ColumnSpacing="8">
            <Border Classes="MasterPane">
            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                <TextBlock Text="实例" Classes="SectionTitle" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Margin="3,4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstanceId}" FontSize="11" FontFamily="monospace" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="2" Content="删除实例" Classes="Danger"
                        Command="{Binding RemoveInstanceCommand}" IsEnabled="{Binding CanRemoveInstance}" />
            </Grid>
            </Border>
            <Border Grid.Column="1" Classes="DetailPane">
            <ScrollViewer IsVisible="{Binding HasSelectedInstance}">
                <StackPanel Spacing="9" Margin="10">
                    <Grid Classes="SectionHeading" ColumnDefinitions="Auto,*">
                        <TextBlock Text="实例配置" Classes="SectionTitle" />
                        <TextBlock Grid.Column="1" Text="连接参数与标签规则" Classes="SectionDescription" />
                    </Grid>
                    <Expander Classes="WorkspaceSection" Header="连接参数" IsExpanded="True">
                        <ItemsControl Classes="Settings" ItemsSource="{Binding InstanceSettings.Children}" />
                    </Expander>
                    <Expander Classes="WorkspaceSection" Header="标签自动规则" IsExpanded="True">
                        <ContentControl Content="{Binding TagRuleEditor}" />
                    </Expander>
                </StackPanel>
            </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
