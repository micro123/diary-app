<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:Diary.RedMine.UI.ViewModels"
             x:Class="Diary.RedMine.UI.Views.RedMineConfigurationView"
             x:DataType="viewModels:RedMineConfigurationViewModel"
             Padding="8">
    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBlock Text="RedMine Tracker 实例" FontSize="18" FontWeight="SemiBold"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="添加实例" Command="{Binding AddInstanceCommand}" />
            <Button Grid.Column="2" Content="删除实例" Classes="Danger"
                    Command="{Binding RemoveInstanceCommand}"
                    IsEnabled="{Binding CanRemoveInstance}" />
        </Grid>
        <Grid Grid.Row="1" ColumnDefinitions="220,*" ColumnSpacing="16">
            <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Spacing="2" Margin="4">
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding InstanceId}" FontSize="11" Opacity="0.6" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelectedInstance}">
                <StackPanel Spacing="12">
                    <Expander Header="实例配置" IsExpanded="True">
                        <ItemsControl Classes="Settings" ItemsSource="{Binding InstanceSettings.Children}" />
                    </Expander>
                    <Expander Header="标签自动规则" IsExpanded="True">
                        <StackPanel Spacing="8">
                            <Button Content="添加规则" HorizontalAlignment="Left" Command="{Binding AddTagRuleCommand}" />
                            <ItemsControl ItemsSource="{Binding TagRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:RedMineTagRuleViewModel">
                                        <Border Padding="8" Margin="0,0,0,6" CornerRadius="6"
                                                Background="{DynamicResource SemiColorFill2}">
                                            <Grid ColumnDefinitions="Auto,160,180,220,90,Auto" ColumnSpacing="8">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" VerticalAlignment="Center" />
                                                <ComboBox Grid.Column="1" ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}">
                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="2" ItemsSource="{Binding Activities}" SelectedItem="{Binding SelectedActivity}">
                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <ComboBox Grid.Column="3" ItemsSource="{Binding Issues}" SelectedItem="{Binding SelectedIssue}">
                                                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <NumericUpDown Grid.Column="4" Value="{Binding Priority}" Minimum="-1000" Maximum="1000" />
                                                <Button Grid.Column="5" Content="删除"
                                                        Command="{Binding $parent[UserControl].((viewModels:RedMineConfigurationViewModel)DataContext).RemoveTagRuleCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
