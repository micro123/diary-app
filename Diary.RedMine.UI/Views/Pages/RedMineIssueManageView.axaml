<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:pages1="clr-namespace:Diary.RedMine.UI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diary.RedMine.UI.Views.Pages.RedMineIssueManageView"
             x:DataType="pages1:RedMineIssueManageViewModel"
             Padding="8">
    <DockPanel VerticalSpacing="4">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" DockPanel.Dock="Top">
            <TextBox Text="{Binding SearchTerm}" Watermark="输入搜索词，Enter键按关键字搜索，Ctrl+Enter按问题ID搜索。">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"
                                CommandParameter="{x:Static pages1:RedMineIssueManageViewModel.SearchByKeyword}" />
                    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding SearchCommand}"
                                CommandParameter="{x:Static pages1:RedMineIssueManageViewModel.SearchById}" />
                </TextBox.KeyBindings>
            </TextBox>
            <CheckBox Grid.Column="1" Content="打开的问题" IsChecked="{Binding OnlyOpened}" />
            <CheckBox Grid.Column="2" Content="分配给我的" IsChecked="{Binding OnlyMyIssues}" />
            <Button Grid.Column="3" Content="关键字搜索" Command="{Binding SearchCommand}"
                    CommandParameter="{x:Static pages1:RedMineIssueManageViewModel.SearchByKeyword}" />
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="8" DockPanel.Dock="Top">
            <Button Content="首页" Command="{Binding FirstPageCommand}" />
            <Button Content="上一页" Command="{Binding PrevPageCommand}" />
            <TextBlock Text="{Binding CurrentPage, StringFormat='第{0}页'}" />
            <TextBlock Text="{Binding TotalPage, StringFormat='共{0}页'}" />
            <Button Content="下一页" Command="{Binding NextPageCommand}" />
            <Button Content="尾页" Command="{Binding LastPageCommand}" />
            <TextBlock Text="{Binding ResultCount, StringFormat='共检索到{0}个问题'}" />
        </StackPanel>
        <DataGrid ItemsSource="{Binding SearchResults}" IsReadOnly="True" x:Name="ResultList">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="Auto" Header="ID" />
                <DataGridTextColumn Binding="{Binding Subject}" Width="*" Header="标题" />
                <DataGridTextColumn Binding="{Binding Project.Name}" Width="*" Header="项目" />
                <DataGridTextColumn Binding="{Binding AssignedTo.Name}" Width="Auto" Header="分配给" />
                <DataGridTextColumn Binding="{Binding Status.Name}" Width="Auto" Header="状态" />
                <DataGridTextColumn Binding="{Binding Priority.Name}" Width="Auto" Header="优先级" />
                <DataGridTemplateColumn Width="120" Header="操作">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="导入问题" Classes="Primary" Padding="0" Width="120"
                                    Command="{Binding #ResultList.((pages1:RedMineIssueManageViewModel)DataContext).ImportCommand}"
                                    CommandParameter="{Binding}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
