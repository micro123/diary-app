<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:redMine="clr-namespace:Diary.RedMine.Models;assembly=Diary.RedMine"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:u="https://irihi.tech/ursa"
             xmlns:pages1="clr-namespace:Diary.RedMine.UI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:DataType="pages1:RedMineInfoViewModel"
             x:Class="Diary.RedMine.UI.Views.Pages.RedMineInfoView"
             Padding="6">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
        <Expander Classes="WorkspaceSection" IsExpanded="False" Header="用户信息">
            <Grid ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="4">
                <TextBlock Grid.Column="0" Grid.Row="0" Text="用户ID：" />
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding UserId}" />
                <TextBlock Grid.Column="0" Grid.Row="1" Text="登录名：" />
                <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding UserLogin}" />
                <TextBlock Grid.Column="0" Grid.Row="2" Text="用户名：" />
                <TextBlock Grid.Column="1" Grid.Row="2" Text="{Binding UserName}" />
            </Grid>
        </Expander>
        <Expander Grid.Row="1" Classes="WorkspaceSection" IsExpanded="False" Header="活动列表">
            <StackPanel Orientation="Vertical" Spacing="8" HorizontalAlignment="Left">
                <ItemsControl ItemsSource="{Binding Activities}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Vertical" Spacing="6" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="{x:Type redMine:RedMineActivity}">
                            <Border BorderThickness="0 0 0 2" HorizontalAlignment="Left"
                                    BorderBrush="{DynamicResource ButtonDefaultPrimaryForeground}">
                                <Grid ColumnDefinitions="28,Auto" ColumnSpacing="2">
                                    <TextBlock Text="{Binding Id,StringFormat='#{0}'}" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
                <Button Command="{Binding SyncActivitiesCommand}" Classes="Primary">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <i:Icon Value="mdi-sync" FontSize="18" />
                        <TextBlock Text="同步服务器定义" FontSize="18" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Expander>
        <Border Grid.Row="2" Classes="SectionCard">
        <Grid RowDefinitions="Auto,*" RowSpacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="已导入的问题" Classes="SectionTitle" />
                    <TextBlock Text="同步远程状态，或重新抓取已导入的问题详情。" Classes="SectionDescription" />
                </StackPanel>
                <StackPanel Grid.Column="1" Classes="CompactActions">
                    <Button Content="与服务器同步" Command="{Binding SyncIssueStateCommand}" />
                    <Button Content="重新抓取" Command="{Binding ReloadIssuesCommand}" />
                </StackPanel>
            </Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Issues}" IsReadOnly="True" x:Name="IssueList">
            <DataGrid.Columns>
                <DataGridTextColumn Width="Auto" Header="ID" Binding="{Binding Id}" />
                <DataGridTextColumn Width="*" Header="描述" Binding="{Binding Title}" />
                <DataGridTextColumn Width="Auto" Header="分配给" Binding="{Binding AssignedTo}" />
                <DataGridTextColumn Width="*" Header="项目" Binding="{Binding Project}" />
                <DataGridCheckBoxColumn Width="Auto" Header="已关闭" Binding="{Binding Disabled}" />
                <DataGridTemplateColumn>
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="2">
                                <Button Content="{Binding !Disabled, Converter={StaticResource IssueOpenClose}}"
                                        Command="{Binding #IssueList.((pages1:RedMineInfoViewModel)DataContext).ToggleIssueCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="删除" Classes="Danger"
                                        Command="{Binding #IssueList.((pages1:RedMineInfoViewModel)DataContext).DeleteIssueCommand}"
                                        CommandParameter="{Binding}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Grid>
        </Border>
    </Grid>
</UserControl>
