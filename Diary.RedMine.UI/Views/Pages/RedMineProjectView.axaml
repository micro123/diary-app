<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:i="https://github.com/projektanker/icons.avalonia"
             xmlns:pages1="clr-namespace:Diary.RedMine.UI.ViewModels.Pages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="Diary.RedMine.UI.Views.Pages.RedMineProjectView"
             x:DataType="pages1:RedMineProjectViewModel" Padding="6">
    <Grid RowDefinitions="Auto,*" RowSpacing="8">
        <Border Classes="PageHeader">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
                <StackPanel Spacing="2">
                    <TextBlock Text="项目管理" Classes="SectionTitle" />
                    <TextBlock Text="搜索 Redmine 项目、查看项目说明并在目标项目中新建问题。"
                               Classes="SectionDescription" />
                </StackPanel>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SearchTerm}" Watermark="输入搜索关键字，Enter键搜索。">
                        <TextBox.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" /></TextBox.KeyBindings>
                    </TextBox>
                    <Button Grid.Column="1" Classes="Primary" Content="搜索" Command="{Binding SearchCommand}" />
                </Grid>
                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="首页" Command="{Binding FirstPageCommand}" />
                    <Button Content="上一页" Command="{Binding PrevPageCommand}" />
                    <TextBlock Classes="PaginationText" Text="{Binding CurrentPage, StringFormat='第{0}页'}" />
                    <TextBlock Classes="PaginationText" Text="{Binding TotalPage, StringFormat='共{0}页'}" />
                    <Button Content="下一页" Command="{Binding NextPageCommand}" />
                    <Button Content="尾页" Command="{Binding LastPageCommand}" />
                    <TextBlock Classes="PaginationText" Text="{Binding ResultCount, StringFormat='共检索到{0}个项目'}" />
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Classes="DetailPane" Padding="6">
        <DataGrid ItemsSource="{Binding SearchResults}" IsReadOnly="True" x:Name="ResultList">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="Auto" Header="ID" />
                <DataGridTextColumn Binding="{Binding Name}" Width="*" Header="标题" />
                <DataGridTemplateColumn Width="140" Header="操作">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <Button i:Attached.Icon="mdi-comment-alert-outline" Command="{Binding #ResultList.((pages1:RedMineProjectViewModel)DataContext).ShowDescCommand}" CommandParameter="{Binding}" />
                            <Button Content="新建问题" Classes="Primary" Command="{Binding #ResultList.((pages1:RedMineProjectViewModel)DataContext).CreateIssueCommand}" CommandParameter="{Binding}" />
                        </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        </Border>
    </Grid>
</UserControl>
